---
const currentPath = Astro.url.pathname;
const isSurahDetail = currentPath.startsWith('/quran/') && currentPath !== '/quran' && currentPath !== '/quran/';
---

<nav id="main-navbar" class="fixed top-0 left-0 right-0 z-50 bg-white/95 dark:bg-[#111827]/95 backdrop-blur-md border-b border-[#f3f4f6] dark:border-[#6b7280]/20 transition-colors duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 md:h-20">
      
      <div class="flex items-center gap-3 min-w-[150px]">
        <div class="flex items-center justify-center w-9 h-9 md:w-10 md:h-10 rounded-none bg-[#009788] text-white shadow-xs">
          <span class="material-symbols-rounded text-xl md:text-2xl">auto_stories</span>
        </div>
        <a href="/" id="brand-link" class="group flex flex-col">
          <span class="text-lg md:text-xl font-extrabold tracking-tight text-[#009788] dark:text-[#009788] transition-colors duration-300 group-hover:text-[#0d8174]">
            Tartiliya
          </span>
          <span class="text-[9px] md:text-[10px] font-semibold text-[#6b7280] dark:text-[#696969] tracking-widest uppercase -mt-1">
            Al-Qur'an Platform
          </span>
        </a>
      </div>

      <div class="hidden md:flex flex-col items-center justify-center py-1">
        <div id="navbar-clock" class="text-2xl font-mono font-bold tracking-widest text-[#111827] dark:text-[#ffffff] tabular-nums flex items-center leading-none">
          <span id="clock-hours" class="inline-block">--</span>
          <span id="clock-separator" class="inline-block text-[#009788] animate-pulse mx-0.5">:</span>
          <span id="clock-minutes" class="inline-block">--</span>
          <span id="clock-separator-2" class="inline-block text-[#009788] animate-pulse mx-0.5">:</span>
          <span id="clock-seconds" class="inline-block text-base text-[#6b7280] dark:text-[#696969] ml-0.5">--</span>
        </div>

        <div id="navbar-info" class="flex items-center gap-2 text-xs text-[#6b7280] dark:text-[#696969] mt-1.5 font-medium">
          <span id="clock-date" class="bg-[#009788] text-white px-2 py-0.5 rounded-none text-[11px] font-bold shadow-xs">Loading...</span>
          <span class="w-1.5 h-1.5 rounded-full bg-[#009788]"></span>
          <span id="clock-timezone" class="text-[#6b7280] dark:text-[#696969]">WIB</span>
        </div>
      </div>

      <div class="flex items-center gap-2 md:gap-3 min-w-[120px] justify-end">
        <div id="search-wrapper" class="relative">
          <button 
            id="search-toggle-btn" 
            class="flex items-center gap-2 px-3.5 py-2 md:px-4 md:py-2.5 rounded-xl text-sm text-[#4b5563] dark:text-gray-300 bg-[#f3f4f6] dark:bg-gray-800 hover:bg-[#e3fcf0] dark:hover:bg-[#0d8174]/20 border border-gray-200 dark:border-gray-700 hover:border-[#009788]/40 hover:text-[#009788] dark:hover:text-[#009788] transition-all duration-200 cursor-pointer shadow-2xs"
            aria-label="Search"
          >
            <span class="material-symbols-rounded text-[20px] text-[#009788]">search</span>
            <span class="hidden sm:inline text-xs font-semibold">Cari Surah...</span>
            <kbd class="hidden lg:inline-flex items-center gap-0.5 px-1.5 py-0.5 text-[10px] font-mono text-gray-500 dark:text-gray-400 bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-700 rounded-md">
              Ctrl+K
            </kbd>
          </button>
        </div>

        <button 
          id="btn-enable-notification"
          class="flex items-center justify-center w-9 h-9 md:w-10 md:h-10 rounded-xl bg-[#f3f4f6] dark:bg-gray-800 hover:bg-[#e3fcf0] dark:hover:bg-[#0d8174]/20 border border-gray-200 dark:border-gray-700 transition-all duration-200 cursor-pointer text-[#009788]"
          aria-label="Aktifkan Notifikasi Adzan"
          title="Notifikasi Adzan"
        >
          <span class="material-symbols-rounded text-lg md:text-xl">notifications</span>
        </button>

        <button 
          id="dark-mode-toggle" 
          class="relative flex items-center justify-center w-9 h-9 md:w-10 md:h-10 rounded-xl bg-[#f3f4f6] dark:bg-gray-800 hover:bg-[#e3fcf0] dark:hover:bg-[#0d8174]/20 border border-gray-200 dark:border-gray-700 transition-all duration-300 cursor-pointer overflow-hidden group"
          aria-label="Toggle dark mode"
        >
          <span id="icon-sun" class="material-symbols-rounded absolute text-lg md:text-xl text-[#009788] transition-all duration-500 transform rotate-0 scale-100 dark:-rotate-90 dark:scale-0">light_mode</span>
          <span id="icon-moon" class="material-symbols-rounded absolute text-lg md:text-xl text-[#00b2ff] transition-all duration-500 transform rotate-90 scale-0 dark:rotate-0 dark:scale-100">dark_mode</span>
        </button>
      </div>
    </div>

    {!isSurahDetail && (
      <div class="hidden md:flex items-center justify-center gap-2 pb-3 pt-1 border-t border-[#f3f4f6] dark:border-[#6b7280]/10 text-sm font-semibold">
        <a 
          href="/" 
          class={`flex items-center gap-1.5 px-4 py-1.5 rounded-xl transition-all whitespace-nowrap ${currentPath === '/' || (currentPath.startsWith('/quran') && !isSurahDetail) ? 'bg-[#009788] text-white shadow-sm font-bold' : 'text-[#6b7280] dark:text-[#696969] hover:bg-gray-100 dark:hover:bg-gray-800 hover:text-[#009788]'}`}
        >
          <span class="material-symbols-rounded text-lg">auto_stories</span>
          Al-Qur'an
        </a>
        <a 
          href="/sholat" 
          class={`flex items-center gap-1.5 px-4 py-1.5 rounded-xl transition-all whitespace-nowrap ${currentPath === '/sholat' ? 'bg-[#009788] text-white shadow-sm font-bold' : 'text-[#6b7280] dark:text-[#696969] hover:bg-gray-100 dark:hover:bg-gray-800 hover:text-[#009788]'}`}
        >
          <span class="material-symbols-rounded text-lg">schedule</span>
          Jadwal Shalat
        </a>
        <a 
          href="/ensiklopedia" 
          class={`flex items-center gap-1.5 px-4 py-1.5 rounded-xl transition-all whitespace-nowrap ${currentPath === '/ensiklopedia' || currentPath === '/hadis' ? 'bg-[#009788] text-white shadow-sm font-bold' : 'text-[#6b7280] dark:text-[#696969] hover:bg-gray-100 dark:hover:bg-gray-800 hover:text-[#009788]'}`}
        >
          <span class="material-symbols-rounded text-lg">menu_book</span>
          Ensiklopedia
        </a>
        <a 
          href="/kalender" 
          class={`flex items-center gap-1.5 px-4 py-1.5 rounded-xl transition-all whitespace-nowrap ${currentPath === '/kalender' ? 'bg-[#009788] text-white shadow-sm font-bold' : 'text-[#6b7280] dark:text-[#696969] hover:bg-gray-100 dark:hover:bg-gray-800 hover:text-[#009788]'}`}
        >
          <span class="material-symbols-rounded text-lg">calendar_month</span>
          Kalender & Kiblat
        </a>
      </div>
    )}
  </div>

  <div class="md:hidden border-t border-[#f3f4f6] dark:border-[#6b7280]/20 px-4 py-1.5 flex items-center justify-between text-xs bg-[#f8fafc] dark:bg-gray-900">
    <div class="flex items-center gap-2">
      <span id="mobile-clock" class="font-mono font-bold text-[#009788] tabular-nums">--:--:--</span>
      <span id="mobile-timezone" class="text-[10px] text-[#6b7280]">WIB</span>
    </div>
    <span id="mobile-date" class="font-medium text-[#6b7280] text-[11px]">Loading...</span>
  </div>
</nav>

{!isSurahDetail && (
  <nav id="bottom-navbar" class="md:hidden fixed bottom-0 left-0 right-0 z-50 bg-white/95 dark:bg-[#111827]/95 backdrop-blur-md border-t border-gray-200 dark:border-gray-800 flex items-center justify-around py-2 px-2 shadow-[0_-4px_16px_rgba(0,0,0,0.06)]">
    <a 
      href="/" 
      class={`flex flex-col items-center justify-center w-16 py-1 transition-all ${currentPath === '/' || (currentPath.startsWith('/quran') && !isSurahDetail) ? 'text-[#009788] font-extrabold' : 'text-gray-500 dark:text-gray-400 hover:text-[#009788]'}`}
    >
      <span class="material-symbols-rounded text-2xl">auto_stories</span>
      <span class="text-[10px] font-bold mt-0.5">Al-Qur'an</span>
    </a>
    <a 
      href="/sholat" 
      class={`flex flex-col items-center justify-center w-16 py-1 transition-all ${currentPath === '/sholat' ? 'text-[#009788] font-extrabold' : 'text-gray-500 dark:text-gray-400 hover:text-[#009788]'}`}
    >
      <span class="material-symbols-rounded text-2xl">schedule</span>
      <span class="text-[10px] font-bold mt-0.5">Shalat</span>
    </a>
    <a 
      href="/ensiklopedia" 
      class={`flex flex-col items-center justify-center w-16 py-1 transition-all ${currentPath === '/ensiklopedia' || currentPath === '/hadis' ? 'text-[#009788] font-extrabold' : 'text-gray-500 dark:text-gray-400 hover:text-[#009788]'}`}
    >
      <span class="material-symbols-rounded text-2xl">menu_book</span>
      <span class="text-[10px] font-bold mt-0.5">Ensiklopedia</span>
    </a>
    <a 
      href="/kalender" 
      class={`flex flex-col items-center justify-center w-16 py-1 transition-all ${currentPath === '/kalender' ? 'text-[#009788] font-extrabold' : 'text-gray-500 dark:text-gray-400 hover:text-[#009788]'}`}
    >
      <span class="material-symbols-rounded text-2xl">calendar_month</span>
      <span class="text-[10px] font-bold mt-0.5">Kalender</span>
    </a>
  </nav>
)}

<div id="search-modal-container" class="hidden fixed inset-0 z-[120] flex items-start sm:items-center justify-center p-4 sm:p-6 overflow-y-auto">
  <div id="search-backdrop" class="fixed inset-0 bg-black/60 backdrop-blur-sm transition-opacity"></div>

  <div class="relative w-full max-w-2xl bg-white dark:bg-[#1a2234] rounded-2xl shadow-2xl border border-gray-200 dark:border-gray-700/80 overflow-hidden flex flex-col my-auto z-10">
    <div class="flex items-center gap-3 px-4 sm:px-6 py-4 border-b border-gray-100 dark:border-gray-800 bg-gray-50/50 dark:bg-gray-900/50">
      <span class="material-symbols-rounded text-2xl text-[#009788] shrink-0">search</span>
      <input 
        id="search-input" 
        type="text" 
        placeholder="Cari surah (contoh: Yasin, Al-Mulk, Al-Kahfi, 36)..." 
        class="flex-1 bg-transparent text-base sm:text-lg text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500 outline-none font-medium"
        autocomplete="off"
      />
      <button 
        id="search-clear-btn" 
        class="hidden text-gray-400 hover:text-gray-600 dark:hover:text-gray-200 p-1 rounded-full hover:bg-gray-200 dark:hover:bg-gray-800 transition-colors"
      >
        <span class="material-symbols-rounded text-xl">close</span>
      </button>
      <button 
        id="search-close-btn" 
        class="px-2.5 py-1 text-xs font-bold text-gray-600 dark:text-gray-300 bg-gray-200 dark:bg-gray-800 rounded-lg hover:bg-gray-300 dark:hover:bg-gray-700 transition-colors cursor-pointer"
      >
        ESC
      </button>
    </div>

    <div id="search-quick-tags" class="px-4 sm:px-6 py-2.5 bg-gray-50 dark:bg-gray-900/30 border-b border-gray-100 dark:border-gray-800 flex items-center gap-2 overflow-x-auto text-xs">
      <span class="text-gray-400 font-semibold shrink-0">Populer:</span>
      <button type="button" class="quick-surah-btn px-2.5 py-1 rounded-lg bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 text-gray-700 dark:text-gray-300 hover:border-[#009788] hover:text-[#009788] font-medium transition-colors cursor-pointer" data-slug="al-fatihah">Al-Fatihah</button>
      <button type="button" class="quick-surah-btn px-2.5 py-1 rounded-lg bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 text-gray-700 dark:text-gray-300 hover:border-[#009788] hover:text-[#009788] font-medium transition-colors cursor-pointer" data-slug="yasin">Yasin</button>
      <button type="button" class="quick-surah-btn px-2.5 py-1 rounded-lg bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 text-gray-700 dark:text-gray-300 hover:border-[#009788] hover:text-[#009788] font-medium transition-colors cursor-pointer" data-slug="al-mulk">Al-Mulk</button>
      <button type="button" class="quick-surah-btn px-2.5 py-1 rounded-lg bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 text-gray-700 dark:text-gray-300 hover:border-[#009788] hover:text-[#009788] font-medium transition-colors cursor-pointer" data-slug="al-kahf">Al-Kahf</button>
      <button type="button" class="quick-surah-btn px-2.5 py-1 rounded-lg bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 text-gray-700 dark:text-gray-300 hover:border-[#009788] hover:text-[#009788] font-medium transition-colors cursor-pointer" data-slug="ar-rahman">Ar-Rahman</button>
    </div>

    <div id="search-results-list" class="max-h-[60vh] overflow-y-auto divide-y divide-gray-100 dark:divide-gray-800/80 p-2">
    </div>
  </div>
</div>

<div id="adzan-toast" class="hidden fixed bottom-20 md:bottom-6 right-4 left-4 md:left-auto md:w-96 z-[100] bg-white dark:bg-[#1f2937] border-2 border-[#009788] rounded-2xl shadow-2xl p-4 transition-all duration-300">
  <div class="flex items-start justify-between gap-3 mb-2">
    <div class="flex items-center gap-2.5">
      <div class="w-10 h-10 rounded-full bg-[#009788] text-white flex items-center justify-center animate-bounce shrink-0">
        <span class="material-symbols-rounded text-2xl">volume_up</span>
      </div>
      <div>
        <div class="text-[10px] uppercase font-bold tracking-wider text-[#009788]">Waktu Shalat Tiba</div>
        <h4 id="adzan-prayer-title" class="text-sm font-extrabold text-[#111827] dark:text-white">Saatnya Shalat</h4>
      </div>
    </div>
    <button id="close-adzan-toast" class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-200 cursor-pointer p-1">
      <span class="material-symbols-rounded text-lg">close</span>
    </button>
  </div>
  <p id="adzan-sub-text" class="text-xs text-gray-500 dark:text-gray-400 mb-3">Mari tunaikan ibadah shalat tepat pada waktunya.</p>
  <div class="flex items-center justify-between gap-2 bg-[#f8fafc] dark:bg-gray-900 p-2 rounded-xl border border-gray-200 dark:border-gray-800">
    <button id="btn-play-adzan" class="flex-1 py-1.5 px-3 rounded-lg bg-[#009788] text-white text-xs font-bold flex items-center justify-center gap-1.5 cursor-pointer hover:bg-[#0d8174] transition-colors">
      <span class="material-symbols-rounded text-base">pause</span>
      Jeda Adzan
    </button>
    <button id="btn-stop-adzan" class="py-1.5 px-3 rounded-lg bg-gray-200 dark:bg-gray-800 text-gray-700 dark:text-gray-200 text-xs font-bold flex items-center justify-center gap-1 cursor-pointer hover:bg-gray-300 dark:hover:bg-gray-700 transition-colors">
      <span class="material-symbols-rounded text-base">stop</span>
      Tutup
    </button>
  </div>
</div>

<div class={isSurahDetail ? 'h-20 md:h-24' : 'h-32 md:h-40'}></div>

<script>
  import { SURAH_LIST } from "../data/surahs";

  function updateClock() {
    const now = new Date();
    const hours = String(now.getHours()).padStart(2, '0');
    const minutes = String(now.getMinutes()).padStart(2, '0');
    const seconds = String(now.getSeconds()).padStart(2, '0');

    const elHours = document.getElementById('clock-hours');
    const elMinutes = document.getElementById('clock-minutes');
    const elSeconds = document.getElementById('clock-seconds');
    if (elHours) elHours.textContent = hours;
    if (elMinutes) elMinutes.textContent = minutes;
    if (elSeconds) elSeconds.textContent = seconds;

    const elMobileClock = document.getElementById('mobile-clock');
    if (elMobileClock) elMobileClock.textContent = `${hours}:${minutes}:${seconds}`;

    const options: Intl.DateTimeFormatOptions = { 
      weekday: 'long', 
      day: 'numeric', 
      month: 'long', 
      year: 'numeric' 
    };
    const dateStr = now.toLocaleDateString('id-ID', options);
    const elDate = document.getElementById('clock-date');
    const elMobileDate = document.getElementById('mobile-date');
    if (elDate) elDate.textContent = dateStr;
    if (elMobileDate) elMobileDate.textContent = dateStr;

    const tzAbbr = Intl.DateTimeFormat('en', { timeZoneName: 'short' })
      .formatToParts(now)
      .find(p => p.type === 'timeZoneName')?.value || 'WIB';
    const elTz = document.getElementById('clock-timezone');
    if (elTz) elTz.textContent = tzAbbr;
  }

  updateClock();
  setInterval(updateClock, 1000);

  function initDarkMode() {
    const toggle = document.getElementById('dark-mode-toggle');
    if (!toggle) return;

    const savedTheme = localStorage.getItem('theme');
    if (savedTheme === 'dark') {
      document.documentElement.classList.add('dark');
    } else {
      document.documentElement.classList.remove('dark');
    }

    toggle.addEventListener('click', () => {
      const isDark = document.documentElement.classList.toggle('dark');
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
    });
  }

  initDarkMode();

  function initSearch() {
    const toggleBtn = document.getElementById('search-toggle-btn');
    const modalContainer = document.getElementById('search-modal-container');
    const backdrop = document.getElementById('search-backdrop');
    const input = document.getElementById('search-input') as HTMLInputElement;
    const clearBtn = document.getElementById('search-clear-btn');
    const closeBtn = document.getElementById('search-close-btn');
    const resultsList = document.getElementById('search-results-list');
    const quickBtns = document.querySelectorAll('.quick-surah-btn');

    if (!toggleBtn || !modalContainer || !backdrop || !input || !closeBtn || !resultsList) return;

    function openSearch() {
      modalContainer?.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
      setTimeout(() => {
        input?.focus();
        renderResults(input.value);
      }, 50);
    }

    function closeSearch() {
      modalContainer?.classList.add('hidden');
      document.body.style.overflow = '';
      if (input) input.value = '';
      if (clearBtn) clearBtn.classList.add('hidden');
    }

    function renderResults(query: string) {
      const q = query.trim().toLowerCase();
      
      if (clearBtn) {
        if (q.length > 0) {
          clearBtn.classList.remove('hidden');
        } else {
          clearBtn.classList.add('hidden');
        }
      }

      const filtered = SURAH_LIST.filter(s => 
        s.name.toLowerCase().includes(q) || 
        s.latinName.toLowerCase().includes(q) || 
        s.translation.toLowerCase().includes(q) || 
        String(s.number) === q
      ).slice(0, 15);

      if (filtered.length === 0) {
        resultsList.innerHTML = `
          <div class="px-6 py-12 text-center text-gray-500 dark:text-gray-400">
            <span class="material-symbols-rounded text-5xl mx-auto mb-3 text-gray-300 dark:text-gray-600">search_off</span>
            <p class="text-base font-semibold text-gray-800 dark:text-gray-200">Surah "${query}" tidak ditemukan</p>
            <p class="text-xs text-gray-400 mt-1">Coba gunakan nama surah lain atau nomor surah (1 - 114)</p>
          </div>
        `;
        return;
      }

      resultsList.innerHTML = filtered.map(s => `
        <a href="/quran/${s.slug}" class="flex items-center justify-between p-3.5 sm:px-4 sm:py-3.5 rounded-xl hover:bg-gray-100/80 dark:hover:bg-gray-800/80 transition-all group">
          <div class="flex items-center gap-3.5 min-w-0">
            <span class="w-7 text-center text-sm sm:text-base font-extrabold text-[#009788] shrink-0 font-mono">
              ${s.number}
            </span>
            <div class="min-w-0">
              <div class="text-sm sm:text-base font-bold text-gray-900 dark:text-white group-hover:text-[#009788] transition-colors truncate">
                ${s.name}
              </div>
              <div class="text-xs text-gray-500 dark:text-gray-400 truncate">
                ${s.translation} • <span class="font-medium text-gray-600 dark:text-gray-300">${s.numberOfAyahs} Ayat</span> • ${s.revelationType}
              </div>
            </div>
          </div>
          <div class="text-right shrink-0 pl-2">
            <span class="font-['Amiri'] text-xl sm:text-2xl text-[#009788] font-bold block">${s.arabicName}</span>
          </div>
        </a>
      `).join('');
    }

    input.addEventListener('input', (e) => {
      renderResults((e.target as HTMLInputElement).value);
    });

    clearBtn?.addEventListener('click', () => {
      input.value = '';
      input.focus();
      renderResults('');
    });

    quickBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const slug = btn.getAttribute('data-slug');
        if (slug) {
          window.location.href = `/quran/${slug}`;
        }
      });
    });

    toggleBtn.addEventListener('click', openSearch);
    closeBtn.addEventListener('click', closeSearch);
    backdrop.addEventListener('click', closeSearch);

    document.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        openSearch();
      }
      if (e.key === 'Escape' && !modalContainer.classList.contains('hidden')) {
        closeSearch();
      }
    });
  }

  initSearch();

  function initAdzanAlert() {
    let adzanAudio: HTMLAudioElement | null = null;

    const adzanToast = document.getElementById('adzan-toast');
    const adzanTitle = document.getElementById('adzan-prayer-title');
    const adzanSubText = document.getElementById('adzan-sub-text');
    const btnPlay = document.getElementById('btn-play-adzan');
    const btnStop = document.getElementById('btn-stop-adzan');
    const btnClose = document.getElementById('close-adzan-toast');
    const btnNotify = document.getElementById('btn-enable-notification');

    btnNotify?.addEventListener('click', async () => {
      if ('Notification' in window) {
        const perm = await Notification.requestPermission();
        if (perm === 'granted') {
          btnNotify.classList.add('text-emerald-500');
          new Notification('Notifikasi Shalat Aktif', {
            body: 'Tartiliya akan mengumandangkan adzan otomatis tepat waktu.',
            icon: '/favicon.svg'
          });
        }
      }
    });

    const fallbackJadwal: Record<string, string> = {
      subuh: '04:35',
      dzuhur: '12:00',
      ashar: '15:20',
      maghrib: '18:02',
      isya: '19:12'
    };

    function playAdzanAudio(prayerName: string = 'dzuhur') {
      const isSubuh = prayerName.toLowerCase() === 'subuh';
      const audioSrc = isSubuh ? '/audio/adzan-subuh.mp3' : '/audio/adzan.mp3';

      if (!adzanAudio || adzanAudio.src !== window.location.origin + audioSrc) {
        if (adzanAudio) adzanAudio.pause();
        adzanAudio = new Audio(audioSrc);
      }

      adzanAudio.currentTime = 0;
      const playPromise = adzanAudio.play();
      if (playPromise !== undefined) {
        playPromise.then(() => {
          if (btnPlay) {
            btnPlay.innerHTML = `<span class="material-symbols-rounded text-base">pause</span> Jeda Adzan`;
          }
        }).catch(() => {
          if (btnPlay) {
            btnPlay.innerHTML = `<span class="material-symbols-rounded text-base animate-pulse">volume_up</span> Putar Suara Adzan`;
          }
        });
      }
    }

    function stopAdzanAudio() {
      if (adzanAudio) {
        adzanAudio.pause();
        adzanAudio.currentTime = 0;
      }
      if (btnPlay) {
        btnPlay.innerHTML = `<span class="material-symbols-rounded text-base">play_arrow</span> Putar Adzan`;
      }
    }

    function triggerAdzanAlert(prayerName: string, prayerTime: string) {
      const formattedName = prayerName.charAt(0).toUpperCase() + prayerName.slice(1);
      if (adzanTitle) adzanTitle.textContent = `Saatnya Shalat ${formattedName} (${prayerTime})`;
      if (adzanSubText) adzanSubText.textContent = `Waktu shalat ${formattedName} telah tiba untuk wilayah Anda. Mari tunaikan shalat.`;
      
      adzanToast?.classList.remove('hidden');

      if ('Notification' in window && Notification.permission === 'granted') {
        try {
          new Notification(`Waktu Shalat ${formattedName} Tiba (${prayerTime})`, {
            body: `Waktu shalat ${formattedName} telah masuk untuk wilayah Anda. Mari tunaikan shalat.`,
            icon: '/favicon.svg'
          });
        } catch (_) {}
      }

      playAdzanAudio(prayerName);
    }

    async function checkPrayerTimes() {
      const now = new Date();
      const currentHHMM = `${String(now.getHours()).padStart(2, '0')}:${String(now.getMinutes()).padStart(2, '0')}`;
      const todayStr = `${now.getFullYear()}-${now.getMonth() + 1}-${now.getDate()}`;

      let jadwal = fallbackJadwal;
      const cachedJadwal = localStorage.getItem('todayJadwalData');
      if (cachedJadwal) {
        try {
          const parsed = JSON.parse(cachedJadwal);
          if (parsed && typeof parsed === 'object') {
            jadwal = { ...fallbackJadwal, ...parsed };
          }
        } catch (_) {}
      }

      for (const [name, time] of Object.entries(jadwal)) {
        if (['subuh', 'dzuhur', 'ashar', 'maghrib', 'isya'].includes(name.toLowerCase())) {
          if (time === currentHHMM) {
            const key = `adzan_notified_${name}_${todayStr}`;
            if (!localStorage.getItem(key)) {
              localStorage.setItem(key, 'true');
              triggerAdzanAlert(name, time);
            }
          }
        }
      }
    }

    btnPlay?.addEventListener('click', () => {
      if (adzanAudio && !adzanAudio.paused) {
        stopAdzanAudio();
      } else {
        playAdzanAudio();
      }
    });

    btnStop?.addEventListener('click', () => {
      stopAdzanAudio();
      adzanToast?.classList.add('hidden');
    });

    btnClose?.addEventListener('click', () => {
      stopAdzanAudio();
      adzanToast?.classList.add('hidden');
    });

    checkPrayerTimes();
    setInterval(checkPrayerTimes, 15000);
  }

  initAdzanAlert();
</script>
