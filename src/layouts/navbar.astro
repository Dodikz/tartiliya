---
const currentPath = Astro.url.pathname;
const isSurahDetail = currentPath.startsWith('/quran/') && currentPath !== '/quran' && currentPath !== '/quran/';
---

<nav id="main-navbar" class="fixed top-0 left-0 right-0 z-50 bg-white/95 dark:bg-[#111827]/95 backdrop-blur-md border-b border-[#f3f4f6] dark:border-[#6b7280]/20 transition-colors duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="flex items-center justify-between h-16 md:h-20">
      

      <div class="flex items-center gap-2.5 min-w-[150px]">
        <div class="flex items-center justify-center w-9 h-9 md:w-10 md:h-10 rounded-xl bg-[#009788] text-white shadow-sm">
          <span class="material-symbols-rounded text-xl md:text-2xl">auto_stories</span>
        </div>
        <a href="/" id="brand-link" class="group flex flex-col">
          <span class="text-lg md:text-xl font-extrabold tracking-tight text-[#009788] dark:text-[#009788] transition-colors duration-300 group-hover:text-[#0d8174]">
            Tartiliya
          </span>
          <span class="text-[9px] md:text-[10px] font-semibold text-[#6b7280] dark:text-[#696969] tracking-widest uppercase -mt-1">
            Al-Qur'an Platform
          </span>
        </a>
      </div>


      <div class="hidden md:flex flex-col items-center justify-center py-1">

        <div id="navbar-clock" class="text-2xl font-mono font-bold tracking-widest text-[#111827] dark:text-[#ffffff] tabular-nums flex items-center leading-none">
          <span id="clock-hours" class="inline-block">--</span>
          <span id="clock-separator" class="inline-block text-[#009788] animate-pulse mx-0.5">:</span>
          <span id="clock-minutes" class="inline-block">--</span>
          <span id="clock-separator-2" class="inline-block text-[#009788] animate-pulse mx-0.5">:</span>
          <span id="clock-seconds" class="inline-block text-base text-[#6b7280] dark:text-[#696969] ml-0.5">--</span>
        </div>

        <div id="navbar-info" class="flex items-center gap-2 text-xs text-[#6b7280] dark:text-[#696969] mt-1.5 font-medium">
          <span id="clock-date" class="bg-[#009788] text-white px-2 py-0.5 rounded-md text-[11px] font-bold shadow-xs">Loading...</span>
          <span class="w-1.5 h-1.5 rounded-full bg-[#009788]"></span>
          <span id="clock-timezone" class="text-[#6b7280] dark:text-[#696969]">WIB</span>
        </div>
      </div>


      <div class="flex items-center gap-2 md:gap-3 min-w-[120px] justify-end">
        

        <div id="search-wrapper" class="relative">
          <button 
            id="search-toggle-btn" 
            class="flex items-center gap-2 px-3 py-2 md:px-3.5 md:py-2.5 rounded-xl text-sm text-[#6b7280] dark:text-[#696969] bg-[#f3f4f6] dark:bg-[#111827] hover:bg-[#e3fcf0] dark:hover:bg-[#0d8174]/20 border border-[#f3f4f6] dark:border-[#6b7280]/30 hover:border-[#009788]/40 hover:text-[#009788] dark:hover:text-[#009788] transition-all duration-200 cursor-pointer"
            aria-label="Search"
          >
            <span class="material-symbols-rounded text-[20px] text-[#009788]">search</span>
            <span class="hidden sm:inline text-xs font-medium">Cari...</span>
            <kbd class="hidden lg:inline-flex items-center gap-0.5 px-1.5 py-0.5 text-[10px] font-mono text-[#6b7280] dark:text-[#696969] bg-white dark:bg-[#111827] border border-[#6b7280]/20 rounded-md">
              ⌘K
            </kbd>
          </button>


          <div 
            id="search-overlay" 
            class="hidden fixed inset-0 z-[100] bg-black/60 transition-opacity duration-300"
          ></div>


          <div 
            id="search-modal" 
            class="hidden fixed top-[20%] md:top-[28%] left-1/2 -translate-x-1/2 z-[110] w-[92%] max-w-lg bg-white dark:bg-[#111827] rounded-2xl shadow-2xl border border-[#f3f4f6] dark:border-[#6b7280]/30 overflow-hidden transition-all duration-300"
          >
            <div class="flex items-center gap-3 px-4 py-3.5 border-b border-[#f3f4f6] dark:border-[#6b7280]/20">
              <span class="material-symbols-rounded text-xl text-[#009788] shrink-0">search</span>
              <input 
                id="search-input" 
                type="text" 
                placeholder="Cari surah (misal: Yasin, Al-Mulk)..." 
                class="flex-1 bg-transparent text-[#111827] dark:text-[#ffffff] placeholder-[#6b7280] text-sm outline-none font-medium"
                autocomplete="off"
              />
              <button id="search-close-btn" class="px-2.5 py-1 text-xs font-semibold text-[#6b7280] dark:text-[#696969] bg-[#f3f4f6] dark:bg-[#111827] border border-[#6b7280]/20 rounded-lg hover:bg-[#e3fcf0] hover:text-[#009788] transition-colors cursor-pointer">
                ESC
              </button>
            </div>
            <div id="search-results-list" class="max-h-72 overflow-y-auto divide-y divide-[#f3f4f6] dark:divide-[#6b7280]/10">
              <div class="px-4 py-8 text-center text-sm text-[#6b7280] dark:text-[#696969]">
                <span class="material-symbols-rounded text-4xl mx-auto mb-2 text-[#009788]/40">search</span>
                <p class="font-medium text-[#111827] dark:text-white">Ketik nama surah untuk mencari...</p>
              </div>
            </div>
          </div>
        </div>


        <button 
          id="dark-mode-toggle" 
          class="relative flex items-center justify-center w-9 h-9 md:w-10 md:h-10 rounded-xl bg-[#f3f4f6] dark:bg-[#111827] hover:bg-[#e3fcf0] dark:hover:bg-[#0d8174]/20 border border-[#f3f4f6] dark:border-[#6b7280]/30 transition-all duration-300 cursor-pointer overflow-hidden group"
          aria-label="Toggle dark mode"
        >

          <span id="icon-sun" class="material-symbols-rounded absolute text-lg md:text-xl text-[#009788] transition-all duration-500 transform rotate-0 scale-100 dark:-rotate-90 dark:scale-0">light_mode</span>

          <span id="icon-moon" class="material-symbols-rounded absolute text-lg md:text-xl text-[#00b2ff] transition-all duration-500 transform rotate-90 scale-0 dark:rotate-0 dark:scale-100">dark_mode</span>
        </button>

      </div>
    </div>


    {!isSurahDetail && (
      <div class="hidden md:flex items-center justify-center gap-2 pb-3 pt-1 border-t border-[#f3f4f6] dark:border-[#6b7280]/10 text-sm font-semibold">
        <a 
          href="/" 
          class={`flex items-center gap-1.5 px-4 py-1.5 rounded-xl transition-all whitespace-nowrap ${currentPath === '/' || (currentPath.startsWith('/quran') && !isSurahDetail) ? 'bg-[#009788] text-white shadow-sm font-bold' : 'text-[#6b7280] dark:text-[#696969] hover:bg-gray-100 dark:hover:bg-gray-800 hover:text-[#009788]'}`}
        >
          <span class="material-symbols-rounded text-lg">auto_stories</span>
          Al-Qur'an
        </a>
        <a 
          href="/sholat" 
          class={`flex items-center gap-1.5 px-4 py-1.5 rounded-xl transition-all whitespace-nowrap ${currentPath === '/sholat' ? 'bg-[#009788] text-white shadow-sm font-bold' : 'text-[#6b7280] dark:text-[#696969] hover:bg-gray-100 dark:hover:bg-gray-800 hover:text-[#009788]'}`}
        >
          <span class="material-symbols-rounded text-lg">schedule</span>
          Jadwal Shalat
        </a>
        <a 
          href="/hadis" 
          class={`flex items-center gap-1.5 px-4 py-1.5 rounded-xl transition-all whitespace-nowrap ${currentPath === '/hadis' ? 'bg-[#009788] text-white shadow-sm font-bold' : 'text-[#6b7280] dark:text-[#696969] hover:bg-gray-100 dark:hover:bg-gray-800 hover:text-[#009788]'}`}
        >
          <span class="material-symbols-rounded text-lg">menu_book</span>
          Hadis
        </a>
        <a 
          href="/kalender" 
          class={`flex items-center gap-1.5 px-4 py-1.5 rounded-xl transition-all whitespace-nowrap ${currentPath === '/kalender' ? 'bg-[#009788] text-white shadow-sm font-bold' : 'text-[#6b7280] dark:text-[#696969] hover:bg-gray-100 dark:hover:bg-gray-800 hover:text-[#009788]'}`}
        >
          <span class="material-symbols-rounded text-lg">calendar_month</span>
          Kalender & Kiblat
        </a>
      </div>
    )}
  </div>


  <div class="md:hidden border-t border-[#f3f4f6] dark:border-[#6b7280]/20 px-4 py-1.5 flex items-center justify-between text-xs bg-[#f8fafc] dark:bg-gray-900">
    <div class="flex items-center gap-2">
      <span id="mobile-clock" class="font-mono font-bold text-[#009788] tabular-nums">--:--:--</span>
      <span id="mobile-timezone" class="text-[10px] text-[#6b7280]">WIB</span>
    </div>
    <span id="mobile-date" class="font-medium text-[#6b7280] text-[11px]">Loading...</span>
  </div>
</nav>


{!isSurahDetail && (
  <nav id="bottom-navbar" class="md:hidden fixed bottom-0 left-0 right-0 z-50 bg-white/95 dark:bg-[#111827]/95 backdrop-blur-md border-t border-gray-200 dark:border-gray-800 flex items-center justify-around py-1.5 px-2 shadow-[0_-4px_16px_rgba(0,0,0,0.06)]">
    <a 
      href="/" 
      class={`flex flex-col items-center justify-center w-16 py-1 transition-all ${currentPath === '/' || (currentPath.startsWith('/quran') && !isSurahDetail) ? 'text-[#009788] font-extrabold' : 'text-gray-500 dark:text-gray-400 hover:text-[#009788]'}`}
    >
      <span class="material-symbols-rounded text-2xl">auto_stories</span>
      <span class="text-[10px] font-bold mt-0.5">Al-Qur'an</span>
    </a>
    <a 
      href="/sholat" 
      class={`flex flex-col items-center justify-center w-16 py-1 transition-all ${currentPath === '/sholat' ? 'text-[#009788] font-extrabold' : 'text-gray-500 dark:text-gray-400 hover:text-[#009788]'}`}
    >
      <span class="material-symbols-rounded text-2xl">schedule</span>
      <span class="text-[10px] font-bold mt-0.5">Shalat</span>
    </a>
    <a 
      href="/hadis" 
      class={`flex flex-col items-center justify-center w-16 py-1 transition-all ${currentPath === '/hadis' ? 'text-[#009788] font-extrabold' : 'text-gray-500 dark:text-gray-400 hover:text-[#009788]'}`}
    >
      <span class="material-symbols-rounded text-2xl">menu_book</span>
      <span class="text-[10px] font-bold mt-0.5">Hadis</span>
    </a>
    <a 
      href="/kalender" 
      class={`flex flex-col items-center justify-center w-16 py-1 transition-all ${currentPath === '/kalender' ? 'text-[#009788] font-extrabold' : 'text-gray-500 dark:text-gray-400 hover:text-[#009788]'}`}
    >
      <span class="material-symbols-rounded text-2xl">calendar_month</span>
      <span class="text-[10px] font-bold mt-0.5">Kalender</span>
    </a>
  </nav>
)}


<div id="adzan-toast" class="hidden fixed bottom-20 md:bottom-6 right-4 left-4 md:left-auto md:w-96 z-[100] bg-white dark:bg-[#1f2937] border-2 border-[#009788] rounded-2xl shadow-2xl p-4 transition-all duration-300">
  <div class="flex items-start justify-between gap-3 mb-2">
    <div class="flex items-center gap-2.5">
      <div class="w-10 h-10 rounded-full bg-[#009788] text-white flex items-center justify-center animate-bounce shrink-0">
        <span class="material-symbols-rounded text-2xl">volume_up</span>
      </div>
      <div>
        <div class="text-[10px] uppercase font-bold tracking-wider text-[#009788]">Waktu Shalat Tiba</div>
        <h4 id="adzan-prayer-title" class="text-sm font-extrabold text-[#111827] dark:text-white">Saatnya Shalat</h4>
      </div>
    </div>
    <button id="close-adzan-toast" class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-200 cursor-pointer p-1">
      <span class="material-symbols-rounded text-lg">close</span>
    </button>
  </div>
  <p id="adzan-sub-text" class="text-xs text-gray-500 dark:text-gray-400 mb-3">Mari tunaikan ibadah shalat tepat pada waktunya.</p>
  <div class="flex items-center justify-between gap-2 bg-[#f8fafc] dark:bg-gray-900 p-2 rounded-xl border border-gray-200 dark:border-gray-800">
    <button id="btn-play-adzan" class="flex-1 py-1.5 px-3 rounded-lg bg-[#009788] text-white text-xs font-bold flex items-center justify-center gap-1.5 cursor-pointer hover:bg-[#0d8174] transition-colors">
      <span class="material-symbols-rounded text-base">play_arrow</span>
      Putar Adzan
    </button>
    <button id="btn-stop-adzan" class="py-1.5 px-3 rounded-lg bg-gray-200 dark:bg-gray-800 text-gray-700 dark:text-gray-200 text-xs font-bold flex items-center justify-center gap-1 cursor-pointer hover:bg-gray-300 dark:hover:bg-gray-700 transition-colors">
      <span class="material-symbols-rounded text-base">stop</span>
      Tutup
    </button>
  </div>
</div>


<div class={isSurahDetail ? 'h-16 md:h-20' : 'h-24 md:h-28'}></div><script>
  import { SURAH_LIST } from "../data/surahs";

  function updateClock() {
    const now = new Date();
    const hours = String(now.getHours()).padStart(2, '0');
    const minutes = String(now.getMinutes()).padStart(2, '0');
    const seconds = String(now.getSeconds()).padStart(2, '0');

    const elHours = document.getElementById('clock-hours');
    const elMinutes = document.getElementById('clock-minutes');
    const elSeconds = document.getElementById('clock-seconds');
    if (elHours) elHours.textContent = hours;
    if (elMinutes) elMinutes.textContent = minutes;
    if (elSeconds) elSeconds.textContent = seconds;

    const elMobileClock = document.getElementById('mobile-clock');
    if (elMobileClock) elMobileClock.textContent = `${hours}:${minutes}:${seconds}`;

    const options: Intl.DateTimeFormatOptions = { 
      weekday: 'long', 
      day: 'numeric', 
      month: 'long', 
      year: 'numeric' 
    };
    const dateStr = now.toLocaleDateString('id-ID', options);
    const elDate = document.getElementById('clock-date');
    const elMobileDate = document.getElementById('mobile-date');
    if (elDate) elDate.textContent = dateStr;
    if (elMobileDate) elMobileDate.textContent = dateStr;

    const tzAbbr = Intl.DateTimeFormat('en', { timeZoneName: 'short' })
      .formatToParts(now)
      .find(p => p.type === 'timeZoneName')?.value || 'WIB';
    const elTz = document.getElementById('clock-timezone');
    if (elTz) elTz.textContent = tzAbbr;
  }

  updateClock();
  setInterval(updateClock, 1000);

  function initDarkMode() {
    const toggle = document.getElementById('dark-mode-toggle');
    if (!toggle) return;

    const savedTheme = localStorage.getItem('theme');
    if (savedTheme === 'dark' || (!savedTheme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
      document.documentElement.classList.add('dark');
    } else {
      document.documentElement.classList.remove('dark');
    }

    toggle.addEventListener('click', () => {
      const isDark = document.documentElement.classList.toggle('dark');
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
    });
  }

  initDarkMode();

  function initSearch() {
    const toggleBtn = document.getElementById('search-toggle-btn');
    const overlay = document.getElementById('search-overlay');
    const modal = document.getElementById('search-modal');
    const input = document.getElementById('search-input') as HTMLInputElement;
    const closeBtn = document.getElementById('search-close-btn');
    const resultsList = document.getElementById('search-results-list');

    if (!toggleBtn || !overlay || !modal || !input || !closeBtn || !resultsList) return;

    function openSearch() {
      overlay?.classList.remove('hidden');
      modal?.classList.remove('hidden');
      requestAnimationFrame(() => {
        input?.focus();
        renderResults('');
      });
    }

    function closeSearch() {
      overlay?.classList.add('hidden');
      modal?.classList.add('hidden');
      if (input) input.value = '';
    }

    function renderResults(query: string) {
      const q = query.trim().toLowerCase();
      const filtered = SURAH_LIST.filter(s => 
        s.name.toLowerCase().includes(q) || 
        s.latinName.toLowerCase().includes(q) || 
        s.translation.toLowerCase().includes(q) || 
        String(s.number) === q
      ).slice(0, 10);

      if (filtered.length === 0) {
        resultsList.innerHTML = `
          <div class="px-4 py-6 text-center text-xs text-[#6b7280]">
            Surah "${query}" tidak ditemukan.
          </div>
        `;
        return;
      }

      resultsList.innerHTML = filtered.map(s => `
        <a href="/quran/${s.slug}" class="flex items-center justify-between px-4 py-3 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors group">
          <div class="flex items-center gap-3">
            <span class="w-8 h-8 rounded-lg bg-gray-100 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 flex items-center justify-center text-xs font-bold text-[#009788]">
              ${s.number}
            </span>
            <div>
              <div class="text-sm font-bold text-[#111827] dark:text-white group-hover:text-[#009788] transition-colors">
                ${s.name}
              </div>
              <div class="text-xs text-[#6b7280]">
                ${s.translation} • ${s.numberOfAyahs} Ayat
              </div>
            </div>
          </div>
          <span class="font-['Amiri'] text-lg text-[#009788] font-bold">${s.arabicName}</span>
        </a>
      `).join('');
    }

    input.addEventListener('input', (e) => {
      renderResults((e.target as HTMLInputElement).value);
    });

    toggleBtn.addEventListener('click', openSearch);
    closeBtn.addEventListener('click', closeSearch);
    overlay.addEventListener('click', closeSearch);

    document.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
        e.preventDefault();
        openSearch();
      }
      if (e.key === 'Escape') {
        closeSearch();
      }
    });
  }

  initSearch();

  function initAdzanAlert() {
    let adzanAudio: HTMLAudioElement | null = null;

    const adzanToast = document.getElementById('adzan-toast');
    const adzanTitle = document.getElementById('adzan-prayer-title');
    const adzanSubText = document.getElementById('adzan-sub-text');
    const btnPlay = document.getElementById('btn-play-adzan');
    const btnStop = document.getElementById('btn-stop-adzan');
    const btnClose = document.getElementById('close-adzan-toast');

    const fallbackJadwal: Record<string, string> = {
      subuh: '04:35',
      dzuhur: '12:00',
      ashar: '15:20',
      maghrib: '18:02',
      isya: '19:12'
    };

    function playAdzanAudio() {
      if (!adzanAudio) {
        adzanAudio = new Audio('/audio/adzan.mp3');
        adzanAudio.onerror = () => {
          console.warn('Local adzan audio fallback triggered.');
          if (adzanAudio) adzanAudio.src = 'https://download.quranicaudio.com/adhan/makkah.mp3';
        };
      }

      adzanAudio.currentTime = 0;
      const playPromise = adzanAudio.play();
      if (playPromise !== undefined) {
        playPromise.then(() => {
          if (btnPlay) {
            btnPlay.innerHTML = `<span class="material-symbols-rounded text-base">pause</span> Jeda Adzan`;
          }
        }).catch((err) => {
          console.warn('Autoplay blocked by browser policy:', err);
          if (btnPlay) {
            btnPlay.innerHTML = `<span class="material-symbols-rounded text-base animate-pulse">volume_up</span> Putar Suara Adzan`;
          }
        });
      }
    }

    function stopAdzanAudio() {
      if (adzanAudio) {
        adzanAudio.pause();
        adzanAudio.currentTime = 0;
      }
      if (btnPlay) {
        btnPlay.innerHTML = `<span class="material-symbols-rounded text-base">play_arrow</span> Putar Adzan`;
      }
    }

    function triggerAdzanAlert(prayerName: string, prayerTime: string) {
      const formattedName = prayerName.charAt(0).toUpperCase() + prayerName.slice(1);
      if (adzanTitle) adzanTitle.textContent = `Saatnya Shalat ${formattedName} (${prayerTime})`;
      if (adzanSubText) adzanSubText.textContent = `Waktu shalat ${formattedName} telah tiba untuk wilayah Anda. Mari tunaikan shalat.`;
      
      adzanToast?.classList.remove('hidden');

      const autoPlayEnabled = localStorage.getItem('adzanAutoPlay') !== 'false';
      if (autoPlayEnabled) {
        playAdzanAudio();
      }
    }

    async function checkPrayerTimes() {
      const now = new Date();
      const currentHHMM = `${String(now.getHours()).padStart(2, '0')}:${String(now.getMinutes()).padStart(2, '0')}`;
      const todayStr = `${now.getFullYear()}-${now.getMonth() + 1}-${now.getDate()}`;

      let jadwal = fallbackJadwal;
      const cachedJadwal = localStorage.getItem('todayJadwalData');
      if (cachedJadwal) {
        try {
          const parsed = JSON.parse(cachedJadwal);
          if (parsed && typeof parsed === 'object') {
            jadwal = { ...fallbackJadwal, ...parsed };
          }
        } catch (_) {}
      }

      for (const [name, time] of Object.entries(jadwal)) {
        if (['subuh', 'dzuhur', 'ashar', 'maghrib', 'isya'].includes(name.toLowerCase())) {
          if (time === currentHHMM) {
            const key = `adzan_notified_${name}_${todayStr}`;
            if (!localStorage.getItem(key)) {
              localStorage.setItem(key, 'true');
              triggerAdzanAlert(name, time);
            }
          }
        }
      }
    }

    btnPlay?.addEventListener('click', () => {
      if (adzanAudio && !adzanAudio.paused) {
        stopAdzanAudio();
      } else {
        playAdzanAudio();
      }
    });

    btnStop?.addEventListener('click', () => {
      stopAdzanAudio();
      adzanToast?.classList.add('hidden');
    });

    btnClose?.addEventListener('click', () => {
      stopAdzanAudio();
      adzanToast?.classList.add('hidden');
    });

    checkPrayerTimes();
    setInterval(checkPrayerTimes, 20000);
  }

  initAdzanAlert();
</script>
