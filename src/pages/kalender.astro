---
import "../styles/global.css";
import Navbar from "../layouts/navbar.astro";
---

<html lang="id">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>Kalender Hijriah & Arah Kiblat - Tartiliya</title>
		
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Amiri:wght@400;700&display=swap" rel="stylesheet" />
		<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap" rel="stylesheet" />
		
		<script is:inline>
			const theme = localStorage.getItem('theme');
			if (theme === 'dark') {
				document.documentElement.classList.add('dark');
			}
		</script>
	</head>
	<body class="min-h-screen bg-[#f8fafc] dark:bg-[#111827] text-[#111827] dark:text-[#f8fafc] transition-colors duration-200">
		<Navbar />
		
		<main class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8 pb-28 md:pb-12">
			<div class="rounded-2xl bg-white dark:bg-[#1f2937] border border-gray-200 dark:border-gray-800 p-6 sm:p-8 mb-8 shadow-xs">
				<div class="inline-flex items-center gap-1.5 px-3 py-1 bg-[#009788] text-white text-xs font-bold uppercase tracking-wider mb-3">
					<span class="material-symbols-rounded text-sm">calendar_month</span>
					Kalender Hijriah & Penunjuk Arah Kiblat
				</div>
				<h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-[#111827] dark:text-white mb-2">
					Kalender Islam & Kiblat
				</h1>
				<p class="text-sm sm:text-base text-gray-600 dark:text-gray-300 font-normal max-w-xl">
					Konversi penanggalan Masehi ke Hijriah serta kalkulator derajat arah kiblat akurat berdasarkan posisi koordinat lokasi Anda.
				</p>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-2 gap-8">
				<div class="p-6 sm:p-8 rounded-2xl bg-white dark:bg-[#1f2937] border border-gray-200 dark:border-gray-800 flex flex-col justify-between shadow-xs">
					<div>
						<div class="flex items-center gap-3 mb-6">
							<div class="w-10 h-10 bg-[#009788] text-white flex items-center justify-center font-bold shadow-xs">
								<span class="material-symbols-rounded text-2xl">event</span>
							</div>
							<div>
								<h2 class="text-base font-bold text-gray-900 dark:text-white">Konversi Tanggal Hijriah</h2>
								<p class="text-xs text-gray-500 dark:text-gray-400">Metode Standar Kemenag / Ummul Qura</p>
							</div>
						</div>

						<div class="mb-6 bg-gray-50 dark:bg-gray-900 border border-gray-200 dark:border-gray-800 rounded-2xl p-5">
							<div class="flex items-center justify-between mb-4">
								<h3 id="cal-month-year-title" class="text-sm font-bold text-gray-900 dark:text-white">
									Agustus 2026
								</h3>
								<div class="flex items-center gap-1">
									<button 
										type="button" 
										id="cal-prev-month" 
										class="p-1.5 rounded-lg hover:bg-gray-200 dark:hover:bg-gray-800 text-gray-500 hover:text-gray-900 dark:hover:text-white transition-colors cursor-pointer"
										title="Bulan Sebelumnya"
									>
										<span class="material-symbols-rounded text-base">chevron_left</span>
									</button>
									<button 
										type="button" 
										id="cal-next-month" 
										class="p-1.5 rounded-lg hover:bg-gray-200 dark:hover:bg-gray-800 text-gray-500 hover:text-gray-900 dark:hover:text-white transition-colors cursor-pointer"
										title="Bulan Selanjutnya"
									>
										<span class="material-symbols-rounded text-base">chevron_right</span>
									</button>
								</div>
							</div>

							<div class="grid grid-cols-7 text-center text-xs font-bold text-gray-400 mb-2">
								<div>M</div>
								<div>S</div>
								<div>S</div>
								<div>R</div>
								<div>K</div>
								<div>J</div>
								<div>S</div>
							</div>

							<div id="cal-days-grid" class="grid grid-cols-7 gap-y-1 gap-x-1 text-center text-xs">
							</div>
						</div>
					</div>

					<div class="p-6 rounded-xl bg-gray-50 dark:bg-gray-900 border border-gray-200 dark:border-gray-800 text-center">
						<div class="text-xs font-bold text-[#009788] uppercase tracking-wider mb-2">Tanggal Hijriah & Peristiwa</div>
						<div id="hijri-result-title" class="text-xl sm:text-2xl font-extrabold text-gray-900 dark:text-white mb-1">
							Memuat...
						</div>
						<div id="hijri-result-sub" class="text-xs text-gray-500 dark:text-gray-400 font-medium mb-3">
							--
						</div>
						
						<div id="islamic-event-badge" class="hidden p-3 rounded-xl bg-[#009788] text-white border border-[#009788] text-left">
							<div class="flex items-center gap-2 text-xs font-bold text-white">
								<span class="material-symbols-rounded text-base">verified</span>
								<span id="event-badge-title">Hari Besar Islam</span>
							</div>
							<p id="event-badge-desc" class="text-xs text-white/90 mt-1 leading-relaxed font-normal">--</p>
						</div>
					</div>

					<div class="mt-6 p-5 rounded-2xl bg-gray-50 dark:bg-gray-900 border border-gray-200 dark:border-gray-800">
						<h3 class="text-xs font-bold uppercase tracking-wider text-[#009788] flex items-center gap-1.5 mb-3">
							<span class="material-symbols-rounded text-base">event_note</span>
							Agenda & Hari Besar Islam
						</h3>
						<div id="month-events-list" class="space-y-2 text-xs">
						</div>
					</div>
				</div>

				<div class="p-6 sm:p-8 rounded-2xl bg-white dark:bg-[#1f2937] border border-gray-200 dark:border-gray-800 flex flex-col justify-between shadow-xs">
					<div>
						<div class="flex items-center justify-between mb-6">
							<div class="flex items-center gap-3">
								<div class="w-10 h-10 bg-[#009788] text-white flex items-center justify-center font-bold shadow-xs">
									<span class="material-symbols-rounded text-2xl">explore</span>
								</div>
								<div>
									<h2 class="text-base font-bold text-gray-900 dark:text-white">Penghitung Arah Kiblat</h2>
									<p class="text-xs text-gray-500 dark:text-gray-400">Realtime Sensor Kompas & GPS</p>
								</div>
							</div>

							<span id="sensor-status-badge" class="px-2.5 py-1 bg-[#009788] text-white text-[10px] font-bold uppercase tracking-wider shadow-xs">
								GPS Siap
							</span>
						</div>

						<div class="grid grid-cols-2 gap-3.5 mb-4">
							<div>
								<label for="input-lat" class="block text-xs font-bold text-gray-500 dark:text-gray-400 uppercase tracking-wider mb-1">Latitude:</label>
								<input id="input-lat" type="number" step="any" value="-6.2088" class="w-full bg-gray-50 dark:bg-gray-900 border border-gray-200 dark:border-gray-700 rounded-xl px-3.5 py-2 text-xs font-semibold text-gray-900 dark:text-white outline-none focus:border-[#009788]" />
							</div>
							<div>
								<label for="input-lon" class="block text-xs font-bold text-gray-500 dark:text-gray-400 uppercase tracking-wider mb-1">Longitude:</label>
								<input id="input-lon" type="number" step="any" value="106.8456" class="w-full bg-gray-50 dark:bg-gray-900 border border-gray-200 dark:border-gray-700 rounded-xl px-3.5 py-2 text-xs font-semibold text-gray-900 dark:text-white outline-none focus:border-[#009788]" />
							</div>
						</div>

						<button id="btn-detect-gps" class="w-full py-2.5 px-4 rounded-xl bg-[#009788] text-white text-xs font-bold flex items-center justify-center gap-2 mb-6 cursor-pointer hover:bg-[#0d8174] transition-colors shadow-xs">
							<span class="material-symbols-rounded text-lg">my_location</span>
							Deteksi Otomatis Lokasi GPS Saya
						</button>
					</div>

					<div class="p-6 rounded-2xl bg-gray-50 dark:bg-gray-900 border border-gray-200 dark:border-gray-800 text-center flex flex-col items-center">
						<div class="text-xs font-bold text-gray-500 dark:text-gray-400 uppercase tracking-wider mb-3 flex items-center gap-1.5 justify-center">
							<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640" class="w-4 h-4 fill-[#009788]"><path d="M320 115.3L156.8 176.4L311.5 235.1C317 237.2 323 237.2 328.5 235.1L483.2 176.4L320 115.3zM64 193.3C64 173.3 76.4 155.4 95.1 148.4L303.1 70.4C314 66.3 325.9 66.3 336.8 70.4L544.8 148.4C563.5 155.4 575.9 173.3 575.9 193.3L575.9 229.3L322.7 325.3C320.9 326 318.9 326 317 325.3L63.8 229.3L63.8 193.3zM64 333.3L64 280.6L300.1 370.2C312.9 375.1 327 375.1 339.8 370.2L575.9 280.6L575.9 333.3L447.9 381.9L447.9 433.2L575.9 384.6L575.9 446.8C575.9 466.8 563.5 484.7 544.8 491.7L336.8 569.7C325.9 573.8 314 573.8 303.1 569.7L95.1 491.7C76.4 484.7 64 466.7 64 446.7L64 384.5L192 433.1L192 381.8L64 333.2zM300.1 474.1C312.9 479 327 479 339.8 474.1L399.9 451.3L399.9 400L322.7 429.3C320.9 430 318.9 430 317 429.3L239.8 400L239.8 451.3L299.9 474.1z"/></svg>
							Derajat Arah Kiblat (Ka'bah)
						</div>
						
						<div class="relative w-48 h-48 my-3 rounded-full border-4 border-[#009788]/20 bg-white dark:bg-gray-800 shadow-inner flex items-center justify-center">
							<span class="absolute top-2 text-xs font-extrabold text-red-500 tracking-wider">N</span>
							<span class="absolute bottom-2 text-xs font-bold text-gray-400">S</span>
							<span class="absolute left-2.5 text-xs font-bold text-gray-400">W</span>
							<span class="absolute right-2.5 text-xs font-bold text-gray-400">E</span>

							<div class="absolute inset-2 rounded-full border border-dashed border-gray-200 dark:border-gray-700 pointer-events-none"></div>

							<div id="compass-needle" class="w-2 h-40 bg-transparent flex flex-col justify-between items-center transition-transform duration-500" style="transform: rotate(295.15deg);">
								<div class="w-9 h-9 rounded-none bg-[#009788] shadow-md flex items-center justify-center text-white ring-2 ring-white dark:ring-gray-900 transform -translate-y-2 p-1.5">
									<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640" class="w-5 h-5 fill-white"><path d="M320 115.3L156.8 176.4L311.5 235.1C317 237.2 323 237.2 328.5 235.1L483.2 176.4L320 115.3zM64 193.3C64 173.3 76.4 155.4 95.1 148.4L303.1 70.4C314 66.3 325.9 66.3 336.8 70.4L544.8 148.4C563.5 155.4 575.9 173.3 575.9 193.3L575.9 229.3L322.7 325.3C320.9 326 318.9 326 317 325.3L63.8 229.3L63.8 193.3zM64 333.3L64 280.6L300.1 370.2C312.9 375.1 327 375.1 339.8 370.2L575.9 280.6L575.9 333.3L447.9 381.9L447.9 433.2L575.9 384.6L575.9 446.8C575.9 466.8 563.5 484.7 544.8 491.7L336.8 569.7C325.9 573.8 314 573.8 303.1 569.7L95.1 491.7C76.4 484.7 64 466.7 64 446.7L64 384.5L192 433.1L192 381.8L64 333.2zM300.1 474.1C312.9 479 327 479 339.8 474.1L399.9 451.3L399.9 400L322.7 429.3C320.9 430 318.9 430 317 429.3L239.8 400L239.8 451.3L299.9 474.1z"/></svg>
								</div>
								<div class="w-3.5 h-3.5 bg-red-500 rounded-full border-2 border-white dark:border-gray-900 shadow"></div>
							</div>
						</div>

						<div id="qibla-degree" class="text-3xl font-mono font-extrabold text-[#009788] mt-2">
							295.15°
						</div>
						<p id="qibla-distance-text" class="text-xs text-gray-500 dark:text-gray-400 mt-1 font-semibold">
							Jarak ke Ka'bah (Mekkah): ~7,914 KM
						</p>
					</div>
				</div>

			</div>
		</main>

		<script>
			const HIJRI_MONTH_NAMES = [
				'Muharram', 'Safar', 'Rabiul Awal', 'Rabiul Akhir',
				'Jumadil Awal', 'Jumadil Akhir', 'Rajab', "Sya'ban",
				'Ramadhan', 'Syawal', "Dzulqa'dah", 'Dzulhijjah'
			];

			const FIXED_ISLAMIC_EVENTS: Record<string, { title: string; desc: string; type: 'holiday' | 'sunnah' | 'special' }> = {
				'1-1': { title: "Tahun Baru Islam (1 Muharram)", desc: "Awal Tahun Baru Hijriah, momentum hijrah Rasulullah SAW.", type: "holiday" },
				'1-9': { title: "Puasa Sunnah Tasu'a (9 Muharram)", desc: "Puasa sunnah dianjurkan sehari sebelum hari Asyura.", type: "sunnah" },
				'1-10': { title: "Hari Asyura & Puasa Asyura (10 Muharram)", desc: "Puasa sunnah Asyura yang menghapuskan dosa setahun lalu.", type: "sunnah" },
				'3-12': { title: "Maulid Nabi Muhammad SAW (12 Rabiul Awal)", desc: "Peringatan hari kelahiran baginda Rasulullah SAW.", type: "holiday" },
				'7-27': { title: "Isra Mi'raj Nabi Muhammad SAW (27 Rajab)", desc: "Perjalanan agung Rasulullah SAW menerima perintah shalat 5 waktu.", type: "holiday" },
				'8-15': { title: "Malam Nisfu Sya'ban (15 Sya'ban)", desc: "Malam keutamaan doa dan pengampunan dosa tahunan.", type: "special" },
				'9-1': { title: "Awal Puasa Ramadhan (1 Ramadhan)", desc: "Hari pertama ibadah puasa wajib di bulan suci Ramadhan.", type: "holiday" },
				'9-17': { title: "Nuzulul Qur'an (17 Ramadhan)", desc: "Peringatan malam diturunkannya permulaan ayat suci Al-Qur'an.", type: "special" },
				'9-21': { title: "Malam Lailatul Qadar (21 Ramadhan)", desc: "Malam ganjil sepuluh malam terakhir Ramadhan yang lebih baik dari 1000 bulan.", type: "special" },
				'9-23': { title: "Malam Lailatul Qadar (23 Ramadhan)", desc: "Malam ganjil sepuluh malam terakhir Ramadhan.", type: "special" },
				'9-25': { title: "Malam Lailatul Qadar (25 Ramadhan)", desc: "Malam ganjil sepuluh malam terakhir Ramadhan.", type: "special" },
				'9-27': { title: "Malam Lailatul Qadar (27 Ramadhan)", desc: "Malam ganjil sepuluh malam terakhir Ramadhan yang sangat diharapkan.", type: "special" },
				'9-29': { title: "Malam Lailatul Qadar (29 Ramadhan)", desc: "Malam ganjil penutup bulan suci Ramadhan.", type: "special" },
				'10-1': { title: "Hari Raya Idul Fitri 1 Syawal", desc: "Hari Raya Kemenangan umat Islam (Diharamkan berpuasa).", type: "holiday" },
				'10-2': { title: "Hari Raya Idul Fitri Hari Ke-2 (2 Syawal)", desc: "Hari kedua perayaan Idul Fitri.", type: "holiday" },
				'12-8': { title: "Hari Tarwiyah & Puasa Tarwiyah (8 Dzulhijjah)", desc: "Hari persiapan jamaah haji menuju Mina dan puasa sunnah Tarwiyah.", type: "sunnah" },
				'12-9': { title: "Hari Arafah & Puasa Arafah (9 Dzulhijjah)", desc: "Wukuf jamaah haji di Arafah & puasa sunnah penghapus dosa 2 tahun.", type: "sunnah" },
				'12-10': { title: "Hari Raya Idul Adha (10 Dzulhijjah)", desc: "Hari Raya Kurban & ibadah penyembelihan kurban (Diharamkan puasa).", type: "holiday" },
				'12-11': { title: "Hari Tasyrik Ke-1 (11 Dzulhijjah)", desc: "Hari makan, minum, dan dzikir (Diharamkan berpuasa).", type: "special" },
				'12-12': { title: "Hari Tasyrik Ke-2 (12 Dzulhijjah)", desc: "Hari Tasyrik ke-2 (Diharamkan berpuasa).", type: "special" },
				'12-13': { title: "Hari Tasyrik Ke-3 (13 Dzulhijjah)", desc: "Hari Tasyrik ke-3 (Diharamkan berpuasa).", type: "special" },
			};

			function getHijriInfo(dateObj: Date): { month: number; day: number; year: number; key: string } {
				try {
					const formatter = new Intl.DateTimeFormat('en-US-u-ca-islamic-civil', {
						year: 'numeric',
						month: 'numeric',
						day: 'numeric'
					});
					const parts = formatter.formatToParts(dateObj);
					const month = parseInt(parts.find(p => p.type === 'month')?.value || '1', 10);
					const day = parseInt(parts.find(p => p.type === 'day')?.value || '1', 10);
					const year = parseInt(parts.find(p => p.type === 'year')?.value || '1448', 10);
					return { month, day, year, key: `${month}-${day}` };
				} catch (_) {
					return { month: 1, day: 1, year: 1448, key: '1-1' };
				}
			}

			function getEventForDate(dateObj: Date): { title: string; desc: string; type: 'holiday' | 'sunnah' | 'special' } | null {
				const hInfo = getHijriInfo(dateObj);
				const dayOfWeek = dateObj.getDay();

				if (FIXED_ISLAMIC_EVENTS[hInfo.key]) {
					return FIXED_ISLAMIC_EVENTS[hInfo.key];
				}

				if ((hInfo.day === 13 || hInfo.day === 14 || hInfo.day === 15) && hInfo.month !== 9 && !(hInfo.month === 12 && hInfo.day === 13)) {
					return {
						title: `Puasa Sunnah Ayyamul Bidh (${hInfo.day} ${HIJRI_MONTH_NAMES[hInfo.month - 1]})`,
						desc: `Puasa sunnah hari-hari putih pertengahan bulan ${HIJRI_MONTH_NAMES[hInfo.month - 1]}.`,
						type: "sunnah"
					};
				}

				if (hInfo.day === 1 && hInfo.month !== 1 && hInfo.month !== 9 && hInfo.month !== 10) {
					return {
						title: `Awal Bulan ${HIJRI_MONTH_NAMES[hInfo.month - 1]}`,
						desc: `Awal masuknya bulan baru ${HIJRI_MONTH_NAMES[hInfo.month - 1]} ${hInfo.year} H.`,
						type: "special"
					};
				}

				if (hInfo.month === 12 && hInfo.day >= 1 && hInfo.day <= 7) {
					return {
						title: `Puasa Awal Dzulhijjah (${hInfo.day} Dzulhijjah)`,
						desc: "Sunnah memperbanyak puasa dan amal kebaikan di 10 hari pertama Dzulhijjah.",
						type: "sunnah"
					};
				}

				if (hInfo.month === 10 && hInfo.day >= 3 && hInfo.day <= 8) {
					return {
						title: `Puasa Sunnah 6 Hari Syawal`,
						desc: "Dianjurkan berpuasa 6 hari di bulan Syawal dengan pahala seperti puasa setahun penuh.",
						type: "sunnah"
					};
				}

				const isHaramFasting = (hInfo.month === 10 && hInfo.day === 1) || (hInfo.month === 12 && hInfo.day >= 10 && hInfo.day <= 13);
				if (hInfo.month !== 9 && !isHaramFasting) {
					if (dayOfWeek === 1) {
						return {
							title: "Puasa Sunnah Senin",
							desc: "Hari di mana amal hamba diperlihatkan kepada Allah dan hari lahirnya Rasulullah SAW.",
							type: "sunnah"
						};
					}
					if (dayOfWeek === 4) {
						return {
							title: "Puasa Sunnah Kamis",
							desc: "Hari diangkatnya catatan amalan hamba ke hadirat Allah SWT.",
							type: "sunnah"
						};
					}
				}

				return null;
			}

			const hijriTitle = document.getElementById('hijri-result-title');
			const hijriSub = document.getElementById('hijri-result-sub');
			const calPrevBtn = document.getElementById('cal-prev-month');
			const calNextBtn = document.getElementById('cal-next-month');
			const eventBadge = document.getElementById('islamic-event-badge');
			const eventBadgeTitle = document.getElementById('event-badge-title');
			const eventBadgeDesc = document.getElementById('event-badge-desc');
			const monthEventsList = document.getElementById('month-events-list');

			let viewYear = new Date().getFullYear();
			let viewMonth = new Date().getMonth();
			let selectedDate = new Date();

			const monthNamesIndo = [
				'Januari', 'Februari', 'Maret', 'April', 'Mei', 'Juni',
				'Juli', 'Agustus', 'September', 'Oktober', 'November', 'Desember'
			];

			function updateHijriDisplay(dateObj: Date) {
				try {
					const hijriFormatter = new Intl.DateTimeFormat('id-ID-u-ca-islamic-civil', {
						dateStyle: 'full'
					});
					const hijriFormatted = hijriFormatter.format(dateObj);

					const ceFormatter = new Intl.DateTimeFormat('id-ID', {
						dateStyle: 'full'
					});
					const ceFormatted = ceFormatter.format(dateObj);

					if (hijriTitle) hijriTitle.textContent = hijriFormatted;
					if (hijriSub) hijriSub.textContent = `Masehi: ${ceFormatted}`;

					const evt = getEventForDate(dateObj);

					if (evt && eventBadge && eventBadgeTitle && eventBadgeDesc) {
						eventBadgeTitle.textContent = evt.title;
						eventBadgeDesc.textContent = evt.desc;
						eventBadge.classList.remove('hidden');
					} else if (eventBadge) {
						eventBadge.classList.add('hidden');
					}
				} catch (_) {}
			}

			function renderCalendar(year: number, month: number) {
				const daysGrid = document.getElementById('cal-days-grid');
				const titleEl = document.getElementById('cal-month-year-title');
				if (!daysGrid || !titleEl) return;

				titleEl.textContent = `${monthNamesIndo[month]} ${year}`;

				const firstDayIndex = new Date(year, month, 1).getDay();
				const totalDays = new Date(year, month + 1, 0).getDate();
				const prevMonthTotalDays = new Date(year, month, 0).getDate();

				let html = '';

				for (let i = firstDayIndex - 1; i >= 0; i--) {
					const prevDay = prevMonthTotalDays - i;
					html += `<div class="p-2 text-gray-300 dark:text-gray-700 select-none text-center">${prevDay}</div>`;
				}

				const today = new Date();
				const isCurrentMonth = today.getFullYear() === year && today.getMonth() === month;

				const foundEventsInMonth: { dateStr: string; title: string; desc: string; type: string }[] = [];

				for (let day = 1; day <= totalDays; day++) {
					const currentDayDate = new Date(year, month, day);
					const isToday = isCurrentMonth && today.getDate() === day;
					const isSelected = selectedDate.getFullYear() === year && selectedDate.getMonth() === month && selectedDate.getDate() === day;

					const evt = getEventForDate(currentDayDate);
					const hasEvent = !!evt;

					if (evt) {
						foundEventsInMonth.push({
							dateStr: `${day} ${monthNamesIndo[month]}`,
							title: evt.title,
							desc: evt.desc,
							type: evt.type
						});
					}

					let bgClass = 'hover:bg-gray-100 dark:hover:bg-gray-800 text-gray-800 dark:text-gray-200';
					let dotClass = 'bg-[#009788]';

					if (isSelected) {
						bgClass = 'bg-[#009788] text-white font-bold shadow-xs';
						dotClass = 'bg-white';
					} else if (isToday) {
						bgClass = 'border-2 border-[#009788] text-[#009788] font-bold';
						dotClass = 'bg-[#009788]';
					} else if (hasEvent) {
						if (evt.type === 'holiday') {
							bgClass = 'bg-amber-50 dark:bg-amber-950/40 text-amber-600 dark:text-amber-400 font-semibold';
							dotClass = 'bg-amber-500';
						} else {
							bgClass = 'bg-emerald-50 dark:bg-emerald-950/40 text-[#009788] font-semibold';
							dotClass = 'bg-[#009788]';
						}
					}

					html += `
						<button 
							type="button" 
							data-day="${day}" 
							class="cal-day-cell p-1.5 sm:p-2 rounded-xl text-xs transition-all relative flex flex-col items-center justify-center cursor-pointer min-h-[42px] sm:min-h-[46px] ${bgClass}"
							title="${hasEvent ? evt.title : ''}"
						>
							<span class="leading-none mb-1">${day}</span>
							${hasEvent ? `<span class="w-1.5 h-1.5 rounded-full ${dotClass} shadow-xs"></span>` : '<span class="w-1.5 h-1.5 opacity-0"></span>'}
						</button>
					`;
				}

				const totalRenderedCells = firstDayIndex + totalDays;
				const remainingCells = (7 - (totalRenderedCells % 7)) % 7;
				for (let i = 1; i <= remainingCells; i++) {
					html += `<div class="p-2 text-gray-300 dark:text-gray-700 select-none text-center">${i}</div>`;
				}

				daysGrid.innerHTML = html;

				if (monthEventsList) {
					if (foundEventsInMonth.length > 0) {
						monthEventsList.innerHTML = foundEventsInMonth.map(ev => `
							<div class="p-2.5 rounded-xl bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 hover:border-[#009788]/50 transition-all">
								<div class="font-bold text-gray-900 dark:text-white flex items-center justify-between">
									<span class="flex items-center gap-1.5">
										<span class="w-2 h-2 rounded-full ${ev.type === 'holiday' ? 'bg-amber-500' : 'bg-[#009788]'}"></span>
										${ev.title}
									</span>
									<span class="text-[10px] text-[#009788] font-mono font-semibold">${ev.dateStr}</span>
								</div>
								<p class="text-gray-500 dark:text-gray-400 text-[11px] mt-1 leading-relaxed">${ev.desc}</p>
							</div>
						`).join('');
					} else {
						monthEventsList.innerHTML = `
							<div class="p-3 text-center text-gray-400">
								Tidak ada hari besar atau agenda ibadah di bulan ini.
							</div>
						`;
					}
				}

				daysGrid.querySelectorAll('.cal-day-cell').forEach(btn => {
					btn.addEventListener('click', (e) => {
						const target = e.currentTarget as HTMLElement;
						const d = parseInt(target.getAttribute('data-day') || '1', 10);
						selectedDate = new Date(year, month, d);
						updateHijriDisplay(selectedDate);
						renderCalendar(year, month);
					});
				});
			}

			calPrevBtn?.addEventListener('click', () => {
				viewMonth--;
				if (viewMonth < 0) {
					viewMonth = 11;
					viewYear--;
				}
				renderCalendar(viewYear, viewMonth);
			});

			calNextBtn?.addEventListener('click', () => {
				viewMonth++;
				if (viewMonth > 11) {
					viewMonth = 0;
					viewYear++;
				}
				renderCalendar(viewYear, viewMonth);
			});

			updateHijriDisplay(selectedDate);
			renderCalendar(viewYear, viewMonth);

			const latInput = document.getElementById('input-lat') as HTMLInputElement;
			const lonInput = document.getElementById('input-lon') as HTMLInputElement;
			const qiblaDegree = document.getElementById('qibla-degree');
			const qiblaDistanceText = document.getElementById('qibla-distance-text');
			const compassNeedle = document.getElementById('compass-needle');
			const btnGps = document.getElementById('btn-detect-gps');
			const sensorBadge = document.getElementById('sensor-status-badge');

			function calcQiblaAngle(lat: number, lon: number): number {
				const latR = (lat * Math.PI) / 180;
				const lonR = (lon * Math.PI) / 180;
				const meccaLat = (21.422487 * Math.PI) / 180;
				const meccaLon = (39.826206 * Math.PI) / 180;

				const dLon = meccaLon - lonR;
				const y = Math.sin(dLon);
				const x = Math.cos(latR) * Math.tan(meccaLat) - Math.sin(latR) * Math.cos(dLon);

				let qibla = (Math.atan2(y, x) * 180) / Math.PI;
				return (qibla + 360) % 360;
			}

			function calcDistanceToMecca(lat: number, lon: number): number {
				const R = 6371;
				const latR = (lat * Math.PI) / 180;
				const meccaLat = (21.422487 * Math.PI) / 180;
				const dLat = ((21.422487 - lat) * Math.PI) / 180;
				const dLon = ((39.826206 - lon) * Math.PI) / 180;

				const a = Math.sin(dLat / 2) * Math.sin(dLat / 2) +
				          Math.cos(latR) * Math.cos(meccaLat) *
				          Math.sin(dLon / 2) * Math.sin(dLon / 2);
				const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
				return Math.round(R * c);
			}

			let targetQiblaDegree = 295.15;

			function updateQibla() {
				if (!latInput || !lonInput || !qiblaDegree) return;
				const lat = parseFloat(latInput.value);
				const lon = parseFloat(lonInput.value);
				if (isNaN(lat) || isNaN(lon)) return;

				targetQiblaDegree = calcQiblaAngle(lat, lon);
				const formattedAngle = targetQiblaDegree.toFixed(2);
				const dist = calcDistanceToMecca(lat, lon);

				qiblaDegree.textContent = `${formattedAngle}°`;
				if (qiblaDistanceText) {
					qiblaDistanceText.textContent = `Jarak ke Ka'bah (Mekkah): ~${dist.toLocaleString('id-ID')} KM`;
				}
				if (compassNeedle) {
					compassNeedle.style.transform = `rotate(${formattedAngle}deg)`;
				}
			}

			latInput?.addEventListener('input', updateQibla);
			lonInput?.addEventListener('input', updateQibla);

			btnGps?.addEventListener('click', () => {
				if (navigator.geolocation) {
					btnGps.innerHTML = `<span class="material-symbols-rounded text-lg animate-spin">sync</span> Mengambil lokasi GPS...`;
					navigator.geolocation.getCurrentPosition(
						(pos) => {
							latInput.value = pos.coords.latitude.toFixed(4);
							lonInput.value = pos.coords.longitude.toFixed(4);
							updateQibla();
							btnGps.innerHTML = `<span class="material-symbols-rounded text-lg">my_location</span> Deteksi Otomatis Lokasi GPS Saya`;
							if (sensorBadge) sensorBadge.textContent = "GPS Terkoneksi";
						},
						(err) => {
							showToast("Gagal mengakses GPS: " + err.message);
							btnGps.innerHTML = `<span class="material-symbols-rounded text-lg">my_location</span> Deteksi Otomatis Lokasi GPS Saya`;
						}
					);
				} else {
					showToast("Browser Anda tidak mendukung geolokasi GPS.");
				}
			});

			if (window.DeviceOrientationEvent) {
				window.addEventListener('deviceorientation', (e: any) => {
					let heading = e.alpha;
					if (e.webkitCompassHeading) {
						heading = e.webkitCompassHeading;
					}
					if (heading !== null && heading !== undefined && compassNeedle) {
						const relativeQibla = (targetQiblaDegree - heading + 360) % 360;
						compassNeedle.style.transform = `rotate(${relativeQibla}deg)`;
						if (sensorBadge) sensorBadge.textContent = "Sensor Kompas Aktif";
					}
				}, true);
			}

			function showToast(message: string) {
				const toast = document.getElementById('toast-notif');
				const toastMsg = document.getElementById('toast-message');
				if (!toast || !toastMsg) return;
				toastMsg.textContent = message;
				toast.classList.remove('translate-y-full', 'opacity-0');
				toast.classList.add('translate-y-0', 'opacity-100');
				setTimeout(() => {
					toast.classList.remove('translate-y-0', 'opacity-100');
					toast.classList.add('translate-y-full', 'opacity-0');
				}, 2500);
			}

			updateQibla();
		</script>

		<div id="toast-notif" class="fixed bottom-24 md:bottom-6 left-1/2 -translate-x-1/2 translate-y-full opacity-0 z-[9999] transition-all duration-300 ease-out pointer-events-none">
			<div class="flex items-center gap-2.5 px-5 py-3 rounded-xl bg-[#009788] text-white text-sm font-semibold shadow-lg shadow-[#009788]/25">
				<span class="material-symbols-rounded text-lg">info</span>
				<span id="toast-message"></span>
			</div>
		</div>
	</body>
</html>
