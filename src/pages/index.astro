---
import "../styles/global.css";
import Navbar from "../layouts/navbar.astro";
import { SURAH_LIST } from "../data/surahs";
---

<html lang="id">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content="Tartiliya - Al-Qur'an Online Terjemah dan Tafsir Bahasa Indonesia" />
		<title>Tartiliya - Al-Qur'an Online Bahasa Indonesia</title>
		
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Amiri:wght@400;700&display=swap" rel="stylesheet" />
		<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=block" rel="stylesheet" />
		
		<script is:inline>
			const theme = localStorage.getItem('theme');
			if (theme === 'dark') {
				document.documentElement.classList.add('dark');
			}
			if ('fonts' in document) {
				Promise.all([
					document.fonts.load('24px "Material Symbols Rounded"'),
					document.fonts.ready
				]).then(() => {
					document.documentElement.classList.add('fonts-loaded');
				}).catch(() => {
					document.documentElement.classList.add('fonts-loaded');
				});
			} else {
				document.documentElement.classList.add('fonts-loaded');
			}
		</script>
	</head>
	<body class="min-h-screen bg-[#f8fafc] dark:bg-[#111827] text-[#111827] dark:text-[#f8fafc] transition-colors duration-200">
		<Navbar />
		
		<main class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8 pb-28 md:pb-12">
			<div class="rounded-2xl bg-white dark:bg-[#1f2937] border border-gray-200 dark:border-gray-800 p-6 sm:p-8 mb-8 shadow-xs">
				<div class="inline-block px-3 py-1 bg-[#009788] text-white text-xs font-bold uppercase tracking-wider mb-3">
					Al-Qur'an Karim • 114 Surah
				</div>
				<h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-[#111827] dark:text-white mb-2">
					Baca Al-Qur'an Online Bahasa Indonesia
				</h1>
				<p class="text-sm sm:text-base text-gray-600 dark:text-gray-300 font-normal leading-relaxed mb-6 max-w-2xl">
					Lengkap dengan teks Arab Utsmani, terjemahan Bahasa Indonesia, audio pelafalan ayat, serta tafsir Kemenag RI.
				</p>

				<div id="last-read-card" class="inline-flex items-center gap-3.5 bg-gray-50 dark:bg-gray-900 border border-gray-200 dark:border-gray-700/80 p-3.5 px-5 rounded-xl">
					<span class="material-symbols-rounded text-2xl text-[#009788]">bookmark</span>
					<div>
						<div class="text-[10px] text-gray-500 uppercase tracking-wider font-bold">Terakhir Dibaca (Browser Anda)</div>
						<a id="last-read-link" href="/quran/al-fatihah" class="text-xs sm:text-sm font-bold text-[#009788] hover:underline flex items-center gap-1.5 mt-0.5">
							<span id="last-read-title">Mulai Baca: Surah Al-Fatihah</span>
							<span class="material-symbols-rounded text-sm">arrow_forward</span>
						</a>
					</div>
				</div>
			</div>

			<div class="flex flex-col sm:flex-row items-center justify-between gap-4 mb-6">
				<div class="flex items-center gap-2 w-full sm:w-auto overflow-x-auto pb-1 sm:pb-0">
					<button id="filter-all" class="filter-btn active px-4 py-2 rounded-xl text-xs font-bold transition-colors bg-[#009788] text-white shrink-0 cursor-pointer shadow-xs">
						Semua (114)
					</button>
					<button id="filter-makkiyah" class="filter-btn px-4 py-2 rounded-xl text-xs font-bold transition-colors bg-white dark:bg-[#1f2937] text-gray-600 dark:text-gray-300 border border-gray-200 dark:border-gray-700 hover:text-[#009788] shrink-0 cursor-pointer">
						Makkiyah
					</button>
					<button id="filter-madaniyah" class="filter-btn px-4 py-2 rounded-xl text-xs font-bold transition-colors bg-white dark:bg-[#1f2937] text-gray-600 dark:text-gray-300 border border-gray-200 dark:border-gray-700 hover:text-[#009788] shrink-0 cursor-pointer">
						Madaniyah
					</button>
				</div>

				<div class="relative w-full sm:w-80">
					<span class="material-symbols-rounded absolute left-3.5 top-1/2 -translate-y-1/2 text-xl text-[#009788] pointer-events-none">search</span>
					<input 
						id="surah-search-input" 
						type="text" 
						placeholder="Cari surah (misal: Yasin, Al-Mulk, 36)..." 
						class="w-full bg-white dark:bg-[#1f2937] border border-gray-200 dark:border-gray-700 rounded-xl pl-10 pr-4 py-2 text-xs sm:text-sm text-gray-900 dark:text-white placeholder-gray-400 outline-none focus:border-[#009788] transition-colors shadow-2xs"
					/>
				</div>
			</div>

			<div id="surah-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
				{SURAH_LIST.map((surah) => (
					<a 
						href={`/quran/${surah.slug}`}
						data-type={surah.revelationType}
						data-search={`${surah.name.toLowerCase()} ${surah.latinName.toLowerCase()} ${surah.translation.toLowerCase()} ${surah.number}`}
						class="surah-card p-4 rounded-xl bg-white dark:bg-[#1f2937] border border-gray-200 dark:border-gray-800 hover:border-[#009788] dark:hover:border-[#009788] transition-all hover:shadow-md flex items-center justify-between group"
					>
						<div class="flex items-center gap-3.5">
							<div class="w-9 h-9 flex items-center justify-center text-xs font-bold text-white bg-[#009788] rounded-none shadow-2xs">
								{surah.number}
							</div>
							<div>
								<h3 class="text-sm sm:text-base font-bold text-gray-900 dark:text-white group-hover:text-[#009788] transition-colors">
									{surah.name}
								</h3>
								<p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5">
									{surah.translation} • <span class="font-semibold text-gray-700 dark:text-gray-300">{surah.numberOfAyahs} Ayat</span>
								</p>
							</div>
						</div>

						<div class="text-right">
							<span class="font-['Amiri'] text-xl font-bold text-[#009788] block">
								{surah.arabicName}
							</span>
							<span class="text-[10px] font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider">
								{surah.revelationType}
							</span>
						</div>
					</a>
				))}
			</div>
		</main>

		<script>
			function loadPersonalLastRead() {
				const lastRead = localStorage.getItem('lastReadSurah');
				const title = document.getElementById('last-read-title');
				const link = document.getElementById('last-read-link') as HTMLAnchorElement;

				if (lastRead && title && link) {
					try {
						const data = JSON.parse(lastRead);
						if (data && data.name) {
							title.textContent = `Lanjutkan: Surah ${data.name}${data.ayah ? ` (Ayat ${data.ayah})` : ''}`;
							link.href = `/quran/${data.slug || 'al-fatihah'}${data.ayah ? `#ayah-${data.ayah}` : ''}`;
						}
					} catch (_) {}
				}
			}

			loadPersonalLastRead();

			const searchInput = document.getElementById('surah-search-input') as HTMLInputElement;
			const cards = document.querySelectorAll('.surah-card');
			const filterBtns = document.querySelectorAll('.filter-btn');

			let activeFilter = 'all';

			function applyFilters() {
				const query = searchInput.value.toLowerCase().trim();
				cards.forEach((card) => {
					const el = card as HTMLElement;
					const type = el.getAttribute('data-type')?.toLowerCase();
					const searchData = el.getAttribute('data-search') || '';

					const matchesFilter = activeFilter === 'all' || type === activeFilter;
					const matchesSearch = !query || searchData.includes(query);

					if (matchesFilter && matchesSearch) {
						el.classList.remove('hidden');
					} else {
						el.classList.add('hidden');
					}
				});
			}

			searchInput?.addEventListener('input', applyFilters);

			filterBtns.forEach((btn) => {
				btn.addEventListener('click', (e) => {
					filterBtns.forEach(b => {
						b.classList.remove('bg-[#009788]', 'text-white', 'active');
						b.classList.add('bg-white', 'dark:bg-[#1f2937]', 'text-gray-600', 'dark:text-gray-300');
					});
					const target = e.currentTarget as HTMLElement;
					target.classList.remove('bg-white', 'dark:bg-[#1f2937]', 'text-gray-600', 'dark:text-gray-300');
					target.classList.add('bg-[#009788]', 'text-white', 'active');

					if (target.id === 'filter-makkiyah') activeFilter = 'makkiyah';
					else if (target.id === 'filter-madaniyah') activeFilter = 'madaniyah';
					else activeFilter = 'all';

					applyFilters();
				});
			});
		</script>
	</body>
</html>
