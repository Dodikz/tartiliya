---
import "../../styles/global.css";
import Navbar from "../../layouts/navbar.astro";
import { SURAH_LIST, findSurahBySlugOrNumber } from "../../data/surahs";
import { QuranService } from "../../lib/api/quran";

export function getStaticPaths() {
  return SURAH_LIST.map((s) => ({
    params: { slug: s.slug },
  }));
}

const { slug } = Astro.params;
const surahMeta = findSurahBySlugOrNumber(slug || "al-fatihah") || SURAH_LIST[0];
const surahNumber = surahMeta.number;

let ayahs: any[] = [];
let fetchError = "";

try {
  const res = await QuranService.getSurah(surahNumber);
  if (res && res.data) {
    const rawData = res.data as any;
    if (rawData.ayahs && Array.isArray(rawData.ayahs)) {
      ayahs = rawData.ayahs;
    } else if (Array.isArray(rawData)) {
      ayahs = rawData;
    } else if (Array.isArray(rawData.data)) {
      ayahs = rawData.data;
    }
  }
} catch (err: any) {
  fetchError = err?.message || "Gagal memuat data ayat.";
}

const prevSurah = surahNumber > 1 ? SURAH_LIST[surahNumber - 2] : null;
const nextSurah = surahNumber < 114 ? SURAH_LIST[surahNumber] : null;

function toArabicNumerals(num: number): string {
  const arabicDigits = ['٠', '١', '٢', '٣', '٤', '٥', '٦', '٧', '٨', '٩'];
  return num.toString().split('').map(d => arabicDigits[parseInt(d, 10)]).join('');
}
---

<html lang="id">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>Surah {surahMeta.name} - Tartiliya Al-Qur'an</title>
		
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Amiri:wght@400;700&family=Scheherazade+New:wght@400;700&display=swap" rel="stylesheet" />
		<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=block" rel="stylesheet" />
		
		<script is:inline>
			const theme = localStorage.getItem('theme');
			if (theme === 'dark') {
				document.documentElement.classList.add('dark');
			}
			if ('fonts' in document) {
				Promise.all([
					document.fonts.load('24px "Material Symbols Rounded"'),
					document.fonts.ready
				]).then(() => {
					document.documentElement.classList.add('fonts-loaded');
				}).catch(() => {
					document.documentElement.classList.add('fonts-loaded');
				});
			} else {
				document.documentElement.classList.add('fonts-loaded');
			}
		</script>

		<style>
			.custom-scrollbar::-webkit-scrollbar {
				width: 5px;
			}
			.custom-scrollbar::-webkit-scrollbar-track {
				background: transparent;
			}
			.custom-scrollbar::-webkit-scrollbar-thumb {
				background: #cbd5e1;
				border-radius: 9999px;
			}
			.dark .custom-scrollbar::-webkit-scrollbar-thumb {
				background: #374151;
			}

			.tajweed-active .arabic-text {
				background: linear-gradient(120deg, rgba(0, 151, 136, 0.08) 0%, rgba(13, 148, 136, 0.12) 100%);
				padding: 4px 8px;
				border-radius: 8px;
			}

			.isyarat-active .isyarat-badge {
				display: inline-flex !important;
			}

			.playing-ayah-active {
				border-color: #009788 !important;
				background-color: rgba(0, 151, 136, 0.05) !important;
			}
		</style>
	</head>
	<body class="min-h-screen bg-[#f8fafc] dark:bg-[#111827] text-[#111827] dark:text-[#f8fafc] transition-colors duration-200 pb-28">
		<Navbar />
		
		<main class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-6 relative">
			<div class="flex flex-wrap items-center justify-between gap-4 mb-8">
				<a href="/" class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-semibold text-[#111827] dark:text-gray-200 hover:text-[#009788] transition-colors">
					<span class="material-symbols-rounded text-lg text-[#009788]">arrow_back</span>
					Daftar Surah
				</a>

				<div class="flex flex-wrap items-center justify-center gap-2">
					<div class="flex items-center gap-1 bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 rounded-full px-2 py-1 text-xs font-semibold">
						{prevSurah ? (
							<a href={`/quran/${prevSurah.slug}`} class="flex items-center gap-1 px-2.5 py-1 rounded-full hover:bg-gray-100 dark:hover:bg-gray-800 text-[#009788] transition-colors">
								<span class="material-symbols-rounded text-sm">chevron_left</span>
								{prevSurah.name}
							</a>
						) : null}

						{nextSurah ? (
							<a href={`/quran/${nextSurah.slug}`} class="flex items-center gap-1 px-2.5 py-1 rounded-full hover:bg-gray-100 dark:hover:bg-gray-800 text-[#009788] transition-colors">
								{nextSurah.name}
								<span class="material-symbols-rounded text-sm">chevron_right</span>
							</a>
						) : null}
					</div>

					<div class="relative" id="surah-dropdown-root">
						<button 
							type="button" 
							id="surah-dropdown-trigger"
							class="flex items-center gap-2 bg-white dark:bg-gray-900 text-[#111827] dark:text-white border border-gray-200 dark:border-gray-800 hover:border-[#009788] font-semibold text-xs rounded-xl px-3.5 py-2 transition-all cursor-pointer outline-none"
						>
							<span>{surahNumber}. {surahMeta.name}</span>
							<span class="material-symbols-rounded text-gray-400 text-base">unfold_more</span>
						</button>

						<div 
							id="surah-dropdown-menu" 
							class="hidden absolute left-0 top-full mt-2 z-50 w-64 bg-white dark:bg-[#1f2937] border border-gray-200 dark:border-gray-700 rounded-2xl p-2 transition-all"
						>
							<div class="p-1 mb-2 relative">
								<span class="material-symbols-rounded absolute left-3.5 top-1/2 -translate-y-1/2 text-gray-400 text-base">search</span>
								<input 
									type="text" 
									id="surah-search-input" 
									placeholder="Cari surah..." 
									autocomplete="off"
									class="w-full bg-[#f8fafc] dark:bg-gray-900 text-[#111827] dark:text-white text-xs rounded-xl pl-8 pr-3 py-1.5 border border-gray-200 dark:border-gray-700 outline-none focus:border-[#009788]"
								/>
							</div>
							<div id="surah-list-container" class="max-h-60 overflow-y-auto space-y-0.5 custom-scrollbar pr-1">
								{SURAH_LIST.map((s) => (
									<a 
										href={`/quran/${s.slug}`}
										data-search={`${s.number} ${s.name} ${s.latinName} ${s.translation}`}
										class={`surah-option-item flex items-center justify-between px-3 py-1.5 rounded-xl text-xs font-semibold transition-colors ${
											s.number === surahNumber 
												? 'bg-[#009788]/10 text-[#009788] dark:bg-[#009788]/20 dark:text-[#009788]' 
												: 'text-[#111827] dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-800'
										}`}
									>
										<span>{s.number}. {s.name}</span>
										{s.number === surahNumber && <span class="material-symbols-rounded text-base text-[#009788]">check</span>}
									</a>
								))}
							</div>
						</div>
					</div>

					<div class="relative" id="ayah-dropdown-root">
						<button 
							type="button" 
							id="ayah-dropdown-trigger"
							class="flex items-center gap-2 bg-white dark:bg-gray-900 text-[#111827] dark:text-white border border-gray-200 dark:border-gray-800 hover:border-[#009788] font-semibold text-xs rounded-xl px-3.5 py-2 transition-all cursor-pointer outline-none"
						>
							<span id="selected-ayah-label">Ayat</span>
							<span class="material-symbols-rounded text-gray-400 text-base">unfold_more</span>
						</button>

						<div 
							id="ayah-dropdown-menu" 
							class="hidden absolute left-0 top-full mt-2 z-50 w-52 bg-white dark:bg-[#1f2937] border border-gray-200 dark:border-gray-700 rounded-2xl p-2 transition-all"
						>
							<div class="text-[10px] font-bold uppercase tracking-wider text-gray-400 px-2 py-1 mb-1">
								Pilih Nomor Ayat
							</div>
							<div class="max-h-56 overflow-y-auto grid grid-cols-4 gap-1 p-1 custom-scrollbar">
								{Array.from({ length: surahMeta.numberOfAyahs }).map((_, i) => (
									<button
										type="button"
										data-ayah-num={i + 1}
										class="ayah-option-btn flex items-center justify-center h-8 rounded-lg text-xs font-bold text-[#111827] dark:text-gray-200 hover:bg-[#009788]/10 hover:text-[#009788] transition-colors cursor-pointer"
									>
										{i + 1}
									</button>
								))}
							</div>
						</div>
					</div>

					<button 
						type="button" 
						id="play-full-surah-btn"
						class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-[#009788] hover:bg-[#008275] text-white text-xs font-bold transition-colors cursor-pointer"
					>
						<span class="material-symbols-rounded text-base">play_circle</span>
						Putar Seluruh Ayat
					</button>
				</div>

				<button 
					type="button" 
					id="settings-toggle-btn"
					class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 hover:border-[#009788] text-xs font-semibold text-[#111827] dark:text-gray-200 transition-all cursor-pointer"
				>
					<span class="material-symbols-rounded text-[#009788] text-lg">settings</span>
					Pengaturan
				</button>
			</div>

			<div 
				id="settings-panel" 
				class="hidden absolute right-4 top-16 z-50 w-80 bg-white dark:bg-[#1f2937] border border-gray-200 dark:border-gray-700 rounded-2xl p-5 transition-all"
			>
				<div class="flex items-center justify-between border-b border-gray-100 dark:border-gray-700 pb-3 mb-4">
					<h3 class="font-bold text-base text-[#111827] dark:text-white flex items-center gap-2">
						Pengaturan
					</h3>
					<button id="close-settings-btn" class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-200 cursor-pointer">
						<span class="material-symbols-rounded text-lg">close</span>
					</button>
				</div>

				<div class="space-y-4 text-xs font-medium text-[#111827] dark:text-gray-200">
					<div>
						<div class="flex items-center justify-between mb-1.5">
							<label for="font-size-slider" class="font-semibold text-gray-700 dark:text-gray-300">Ukuran Font</label>
							<span id="font-size-val" class="font-mono text-[#009788] font-bold text-xs">36px</span>
						</div>
						<input 
							type="range" 
							id="font-size-slider" 
							min="20" 
							max="60" 
							value="36" 
							class="w-full h-1.5 bg-gray-200 dark:bg-gray-700 rounded-lg appearance-none cursor-pointer accent-[#009788]"
						/>
					</div>

					<div class="flex items-center justify-between">
						<span class="text-gray-700 dark:text-gray-300">Quran Tajweed</span>
						<label class="relative inline-flex items-center cursor-pointer">
							<input type="checkbox" id="toggle-tajweed" class="sr-only peer" />
							<div class="w-9 h-5 bg-gray-200 peer-focus:outline-none rounded-full peer dark:bg-gray-700 peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all dark:after:border-gray-600 peer-checked:bg-[#009788]"></div>
						</label>
					</div>

					<div class="flex items-center justify-between">
						<span class="text-gray-700 dark:text-gray-300">Quran Isyarat</span>
						<label class="relative inline-flex items-center cursor-pointer">
							<input type="checkbox" id="toggle-isyarat" class="sr-only peer" />
							<div class="w-9 h-5 bg-gray-200 peer-focus:outline-none rounded-full peer dark:bg-gray-700 peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all dark:after:border-gray-600 peer-checked:bg-[#009788]"></div>
						</label>
					</div>

					<div class="flex items-center justify-between">
						<span class="text-gray-700 dark:text-gray-300">Transliterasi (Latin)</span>
						<label class="relative inline-flex items-center cursor-pointer">
							<input type="checkbox" id="toggle-latin" checked class="sr-only peer" />
							<div class="w-9 h-5 bg-gray-200 peer-focus:outline-none rounded-full peer dark:bg-gray-700 peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all dark:after:border-gray-600 peer-checked:bg-[#009788]"></div>
						</label>
					</div>

					<div class="flex items-center justify-between">
						<span class="text-gray-700 dark:text-gray-300">Terjemahan Bahasa</span>
						<label class="relative inline-flex items-center cursor-pointer">
							<input type="checkbox" id="toggle-translation" checked class="sr-only peer" />
							<div class="w-9 h-5 bg-gray-200 peer-focus:outline-none rounded-full peer dark:bg-gray-700 peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all dark:after:border-gray-600 peer-checked:bg-[#009788]"></div>
						</label>
					</div>

					<div>
						<label class="block text-gray-700 dark:text-gray-300 mb-1.5">Pilih Bahasa Terjemahan</label>
						<div class="flex flex-wrap gap-1.5">
							<button type="button" class="lang-btn px-2.5 py-1 rounded-full text-xs font-semibold bg-[#009788] text-white cursor-pointer" data-lang="ID">ID</button>
							<button type="button" class="lang-btn px-2.5 py-1 rounded-full text-xs font-semibold bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-300 hover:bg-gray-200 cursor-pointer" data-lang="EN">EN</button>
							<button type="button" class="lang-btn px-2.5 py-1 rounded-full text-xs font-semibold bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-300 hover:bg-gray-200 cursor-pointer" data-lang="MY">MY</button>
							<button type="button" class="lang-btn px-2.5 py-1 rounded-full text-xs font-semibold bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-300 hover:bg-gray-200 cursor-pointer" data-lang="FR">FR</button>
							<button type="button" class="lang-btn px-2.5 py-1 rounded-full text-xs font-semibold bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-300 hover:bg-gray-200 cursor-pointer" data-lang="DE">DE</button>
							<button type="button" class="lang-btn px-2.5 py-1 rounded-full text-xs font-semibold bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-300 hover:bg-gray-200 cursor-pointer" data-lang="TR">TR</button>
						</div>
					</div>

					<div>
						<label class="block text-gray-700 dark:text-gray-300 mb-1.5">Pilih Qori</label>
						<div class="relative" id="qori-dropdown-root">
							<button 
								type="button" 
								id="qori-dropdown-trigger"
								class="w-full flex items-center justify-between bg-[#f8fafc] dark:bg-gray-900 text-[#111827] dark:text-white border border-gray-200 dark:border-gray-700 rounded-xl px-3 py-2 text-xs font-semibold outline-none hover:border-[#009788] focus:border-[#009788] cursor-pointer transition-colors"
							>
								<span id="qori-selected-label">Mishari Rashid Alafasy</span>
								<span class="material-symbols-rounded text-gray-400" style="font-size: 16px;">unfold_more</span>
							</button>
							<input type="hidden" id="qori-select" value="mishari" />
							<div 
								id="qori-dropdown-menu" 
								class="hidden absolute left-0 bottom-full mb-2 z-50 w-full bg-white dark:bg-[#1f2937] border border-gray-200 dark:border-gray-700 rounded-xl p-1 transition-all"
							>
								<button type="button" data-qori="mishari" class="qori-option-btn w-full flex items-center justify-between px-3 py-2 rounded-lg text-xs font-semibold text-[#111827] dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors cursor-pointer">
									<span>Mishari Rashid Alafasy</span>
									<span class="qori-check material-symbols-rounded text-[#009788]" style="font-size: 16px;">check</span>
								</button>
								<button type="button" data-qori="sudais" class="qori-option-btn w-full flex items-center justify-between px-3 py-2 rounded-lg text-xs font-semibold text-[#111827] dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors cursor-pointer">
									<span>Abdul Rahman Al-Sudais</span>
									<span class="qori-check material-symbols-rounded text-[#009788] hidden" style="font-size: 16px;">check</span>
								</button>
								<button type="button" data-qori="ghamdi" class="qori-option-btn w-full flex items-center justify-between px-3 py-2 rounded-lg text-xs font-semibold text-[#111827] dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors cursor-pointer">
									<span>Saad Al-Ghamdi</span>
									<span class="qori-check material-symbols-rounded text-[#009788] hidden" style="font-size: 16px;">check</span>
								</button>
								<button type="button" data-qori="husary" class="qori-option-btn w-full flex items-center justify-between px-3 py-2 rounded-lg text-xs font-semibold text-[#111827] dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors cursor-pointer">
									<span>Mahmoud Khalil Al-Husary</span>
									<span class="qori-check material-symbols-rounded text-[#009788] hidden" style="font-size: 16px;">check</span>
								</button>
								<button type="button" data-qori="shatri" class="qori-option-btn w-full flex items-center justify-between px-3 py-2 rounded-lg text-xs font-semibold text-[#111827] dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors cursor-pointer">
									<span>Abu Bakr Al-Shatri</span>
									<span class="qori-check material-symbols-rounded text-[#009788] hidden" style="font-size: 16px;">check</span>
								</button>
							</div>
						</div>
					</div>
				</div>
			</div>

			<div class="text-center my-8">
				<div class="font-['Amiri'] text-4xl sm:text-5xl font-bold text-[#111827] dark:text-white mb-2 tracking-wide">
					سُورَةُ {surahMeta.arabicName}
				</div>
				<h1 class="text-2xl sm:text-3xl font-extrabold text-[#111827] dark:text-white mb-1">
					Surah {surahMeta.name}
				</h1>
				<p class="text-xs sm:text-sm font-semibold text-[#6b7280]">
					{surahMeta.revelationType} · {surahMeta.numberOfAyahs} Ayat
				</p>

				{surahNumber !== 1 && surahNumber !== 9 && (
					<div class="mt-6 font-['Scheherazade_New'] text-3xl sm:text-4xl text-[#111827] dark:text-white font-bold tracking-wider">
						بِسْمِ اللّٰهِ الرَّحْمٰنِ الرَّحِيْمِ
					</div>
				)}
			</div>

			{fetchError && (
				<div class="p-4 rounded-xl bg-red-50 dark:bg-red-950/40 border border-red-200 text-center text-red-600 dark:text-red-400 text-sm mb-6 font-medium">
					{fetchError}
				</div>
			)}

			<div id="quran-ayahs-container" class="space-y-6 my-8">
				{ayahs.slice(0, 10).map((ayah) => (
					<div 
						id={`ayah-${ayah.ayah_number}`}
						data-ayah-num={ayah.ayah_number}
						class="ayah-card relative flex items-start gap-4 p-4 sm:p-6 rounded-2xl bg-white dark:bg-[#111827] border border-gray-100 dark:border-gray-800 transition-all"
					>
						<div class="flex flex-col items-center gap-3 pt-1">
							<div class="relative group">
								<button class="text-gray-400 hover:text-[#009788] cursor-pointer p-1 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors" title="Opsi Ayat">
									<span class="material-symbols-rounded text-xl">more_vert</span>
								</button>
								
								<div class="hidden group-hover:block absolute left-0 top-full z-20 w-36 bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 rounded-xl p-1.5 text-xs font-semibold">
									<button data-ayah-num={ayah.ayah_number} class="single-play-btn w-full flex items-center gap-2 px-2.5 py-1.5 rounded-lg hover:bg-[#009788]/10 hover:text-[#009788] text-[#6b7280]">
										<span class="material-symbols-rounded text-base">play_circle</span>
										Putar Audio
									</button>
									{ayah.tafsir && (
										<button 
											data-tafsir-short={ayah.tafsir.kemenag?.short || ''} 
											data-tafsir-long={ayah.tafsir.kemenag?.long || ''}
											data-surah-name={surahMeta.name}
											data-ayah-num={ayah.ayah_number}
											class="show-tafsir-btn w-full flex items-center gap-2 px-2.5 py-1.5 rounded-lg hover:bg-[#009788]/10 hover:text-[#009788] text-[#6b7280]"
										>
											<span class="material-symbols-rounded text-base">menu_book</span>
											Tafsir
										</button>
									)}
									<button 
										data-surah-slug={surahMeta.slug}
										data-surah-name={surahMeta.name}
										data-ayah-num={ayah.ayah_number}
										class="bookmark-btn w-full flex items-center gap-2 px-2.5 py-1.5 rounded-lg hover:bg-[#009788]/10 hover:text-[#009788] text-[#6b7280]"
									>
										<span class="material-symbols-rounded text-base">bookmark</span>
										Tandai
									</button>
								</div>
							</div>
						</div>

						<div class="flex-1 space-y-4">
							<div class="text-right leading-[2.4] text-[#111827] dark:text-white font-['Scheherazade_New'] font-bold flex items-center justify-end flex-wrap gap-2">
								<span class="arabic-text" style="font-size: 36px;">
									{ayah.arab}
								</span>
								<span class="inline-flex items-center justify-center w-8 h-8 rounded-full border border-[#009788] text-[#009788] text-sm font-['Amiri'] font-bold ml-2">
									{toArabicNumerals(ayah.ayah_number)}
								</span>
							</div>

							<div class="latin-container text-xs sm:text-sm font-medium text-[#009788] leading-relaxed">
								<span class="italic">Ayat {ayah.ayah_number}</span>
							</div>

							<div class="isyarat-badge hidden items-center gap-1 px-2.5 py-1 rounded-lg bg-[#009788] text-white text-[11px] font-bold shadow-xs">
								<span class="material-symbols-rounded text-sm">front_hand</span>
								ISYARAT: Aksesibilitas Pembacaan Ayat {ayah.ayah_number}
							</div>

							<div data-ayah-num={ayah.ayah_number} class="translation-container text-xs sm:text-sm text-[#4b5563] dark:text-gray-300 leading-relaxed font-normal">
								{ayah.translation}
							</div>
						</div>
					</div>
				))}
			</div>

			<div id="infinite-scroll-sentinel" class="flex items-center justify-center py-8">
				<div id="scroll-loading-spinner" class="flex items-center gap-2 text-xs font-semibold text-[#009788]">
					<span class="material-symbols-rounded text-lg animate-spin">progress_activity</span>
					Memuat ayat selanjutnya...
				</div>
			</div>

			<div class="flex items-center justify-between gap-4 mt-8 pt-6 border-t border-gray-200 dark:border-gray-800">
				{prevSurah ? (
					<a href={`/quran/${prevSurah.slug}`} class="flex items-center gap-2 px-4 py-2 rounded-xl bg-white dark:bg-[#111827] border border-gray-200 dark:border-gray-800 hover:border-[#009788] text-xs sm:text-sm font-bold text-[#009788] transition-colors">
						<span class="material-symbols-rounded text-lg">arrow_back</span>
						Surah {prevSurah.name}
					</a>
				) : <div />}

				{nextSurah ? (
					<a href={`/quran/${nextSurah.slug}`} class="flex items-center gap-2 px-4 py-2 rounded-xl bg-white dark:bg-[#111827] border border-gray-200 dark:border-gray-800 hover:border-[#009788] text-xs sm:text-sm font-bold text-[#009788] transition-colors">
						Surah {nextSurah.name}
						<span class="material-symbols-rounded text-lg">arrow_forward</span>
					</a>
				) : <div />}
			</div>

			<div id="full-audio-player-bar" class="hidden fixed bottom-0 left-0 right-0 z-50 bg-white/95 dark:bg-[#1f2937]/95 backdrop-blur-md border-t border-gray-200 dark:border-gray-700 transition-all">
				<div class="w-full h-1 bg-gray-200 dark:bg-gray-700">
					<div id="player-progress-bar" class="h-full bg-[#009788] transition-all duration-300" style="width: 0%"></div>
				</div>

				<div class="max-w-5xl mx-auto px-4 py-3 flex items-center justify-between gap-4">
					<div class="flex items-center gap-3 min-w-0">
						<div class="w-9 h-9 shrink-0 rounded-lg bg-[#009788] text-white flex items-center justify-center">
							<span class="material-symbols-rounded text-lg" style="font-size: 20px;">volume_up</span>
						</div>
						<div class="min-w-0">
							<div id="player-surah-title" class="text-xs font-bold text-[#111827] dark:text-white truncate">
								Surah {surahMeta.name}
							</div>
							<div id="player-ayah-title" class="text-[11px] font-semibold text-[#009788]">
								Ayat 1 / {surahMeta.numberOfAyahs}
							</div>
						</div>
					</div>

					<div class="flex items-center gap-1.5">
						<button id="player-prev-btn" class="w-9 h-9 rounded-lg bg-gray-100 dark:bg-gray-800 text-[#111827] dark:text-gray-200 hover:text-[#009788] hover:bg-gray-200 dark:hover:bg-gray-700 transition-colors cursor-pointer flex items-center justify-center" title="Ayat Sebelumnya">
							<span class="material-symbols-rounded" style="font-size: 20px;">skip_previous</span>
						</button>

						<button id="player-play-pause-btn" class="h-9 px-4 rounded-lg bg-[#009788] hover:bg-[#008275] text-white font-bold text-xs flex items-center gap-1.5 transition-colors cursor-pointer">
							<span id="player-play-icon" class="material-symbols-rounded" style="font-size: 18px;">pause</span>
							<span id="player-play-text">Jeda</span>
						</button>

						<button id="player-next-btn" class="w-9 h-9 rounded-lg bg-gray-100 dark:bg-gray-800 text-[#111827] dark:text-gray-200 hover:text-[#009788] hover:bg-gray-200 dark:hover:bg-gray-700 transition-colors cursor-pointer flex items-center justify-center" title="Ayat Selanjutnya">
							<span class="material-symbols-rounded" style="font-size: 20px;">skip_next</span>
						</button>

						<button id="player-stop-btn" class="w-9 h-9 rounded-lg bg-red-50 dark:bg-red-950/40 text-red-500 hover:bg-red-100 dark:hover:bg-red-950/60 transition-colors cursor-pointer flex items-center justify-center ml-1" title="Hentikan Audio">
							<span class="material-symbols-rounded" style="font-size: 20px;">stop_circle</span>
						</button>
					</div>

					<div class="text-right hidden sm:block">
						<div id="player-counter" class="text-xs font-mono font-bold text-[#009788]">1 / {surahMeta.numberOfAyahs}</div>
					</div>
				</div>
			</div>

			<div id="tafsir-modal-overlay" class="hidden fixed inset-0 z-[100] bg-black/60"></div>
			<div id="tafsir-modal" class="hidden fixed top-[20%] left-1/2 -translate-x-1/2 z-[110] w-[90%] max-w-2xl bg-white dark:bg-[#111827] rounded-2xl border border-gray-200 dark:border-gray-800 overflow-hidden">
				<div class="flex items-center justify-between px-6 py-4 border-b border-gray-100 dark:border-gray-800">
					<h3 id="tafsir-modal-title" class="font-bold text-sm text-[#111827] dark:text-white flex items-center gap-2">
						<span class="material-symbols-rounded text-[#009788]">menu_book</span>
						Tafsir Kemenag RI
					</h3>
					<button id="close-tafsir-btn" class="p-1 text-[#6b7280] hover:text-[#009788] cursor-pointer">
						<span class="material-symbols-rounded text-xl">close</span>
					</button>
				</div>
				<div class="p-6 max-h-[60vh] overflow-y-auto space-y-4">
					<div id="tafsir-modal-body" class="text-xs sm:text-sm leading-relaxed text-[#6b7280] dark:text-gray-300 whitespace-pre-wrap font-normal"></div>
				</div>
			</div>
		</main>

		<script is:inline define:vars={{ currentSurahNum: surahNumber, totalAyahCount: surahMeta.numberOfAyahs, surahNameStr: surahMeta.name, surahSlugStr: surahMeta.slug, allAyahsJson: JSON.stringify(ayahs) }}>
			window.SURAH_NUM = currentSurahNum;
			window.TOTAL_AYAH_COUNT = totalAyahCount;
			window.SURAH_NAME_STR = surahNameStr;
			window.SURAH_SLUG_STR = surahSlugStr;
			window.ALL_AYAHS_DATA = JSON.parse(allAyahsJson);
		</script>

		<script>
			const surahNum = (window as any).SURAH_NUM || 1;
			const totalAyahs = (window as any).TOTAL_AYAH_COUNT || 1;
			const surahName = (window as any).SURAH_NAME_STR || "Al-Fatihah";
			const surahSlug = (window as any).SURAH_SLUG_STR || "al-fatihah";
			const allAyahs: any[] = (window as any).ALL_AYAHS_DATA || [];

			const BATCH_SIZE = 10;
			let loadedAyahCount = Math.min(BATCH_SIZE, allAyahs.length);
			let isAllLoaded = loadedAyahCount >= allAyahs.length;

			function toArabicNum(num: number): string {
				const digits = ['٠', '١', '٢', '٣', '٤', '٥', '٦', '٧', '٨', '٩'];
				return num.toString().split('').map(d => digits[parseInt(d, 10)]).join('');
			}

			function buildAyahCardHTML(ayah: any): string {
				const savedFontSize = JSON.parse(localStorage.getItem('quran_settings') || '{}').fontSize || 36;
				const showLatin = JSON.parse(localStorage.getItem('quran_settings') || '{}').showLatin;
				const showTranslation = JSON.parse(localStorage.getItem('quran_settings') || '{}').showTranslation;
				const latinHidden = showLatin === false ? 'hidden' : '';
				const translationHidden = showTranslation === false ? 'hidden' : '';

				let tafsirBtn = '';
				if (ayah.tafsir) {
					const shortT = ayah.tafsir?.kemenag?.short || '';
					const longT = ayah.tafsir?.kemenag?.long || '';
					tafsirBtn = `
						<button 
							data-tafsir-short="${shortT.replace(/"/g, '&quot;')}" 
							data-tafsir-long="${longT.replace(/"/g, '&quot;')}"
							data-surah-name="${surahName}"
							data-ayah-num="${ayah.ayah_number}"
							class="show-tafsir-btn w-full flex items-center gap-2 px-2.5 py-1.5 rounded-lg hover:bg-[#009788]/10 hover:text-[#009788] text-[#6b7280]"
						>
							<span class="material-symbols-rounded text-base">menu_book</span>
							Tafsir
						</button>`;
				}

				return `
				<div 
					id="ayah-${ayah.ayah_number}"
					data-ayah-num="${ayah.ayah_number}"
					class="ayah-card relative flex items-start gap-4 p-4 sm:p-6 rounded-2xl bg-white dark:bg-[#111827] border-1 border-gray-100 dark:border-gray-800 transition-all"
				>
					<div class="flex flex-col items-center gap-3 pt-1">
						<div class="relative group">
							<button class="text-gray-400 hover:text-[#009788] cursor-pointer p-1 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors" title="Opsi Ayat">
								<span class="material-symbols-rounded text-xl">more_vert</span>
							</button>
							<div class="hidden group-hover:block absolute left-0 top-full z-20 w-36 bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 rounded-xl p-1.5 text-xs font-semibold">
								<button data-ayah-num="${ayah.ayah_number}" class="single-play-btn w-full flex items-center gap-2 px-2.5 py-1.5 rounded-lg hover:bg-[#009788]/10 hover:text-[#009788] text-[#6b7280]">
									<span class="material-symbols-rounded text-base">play_circle</span>
									Putar Audio
								</button>
								${tafsirBtn}
								<button 
									data-surah-slug="${surahSlug}"
									data-surah-name="${surahName}"
									data-ayah-num="${ayah.ayah_number}"
									class="bookmark-btn w-full flex items-center gap-2 px-2.5 py-1.5 rounded-lg hover:bg-[#009788]/10 hover:text-[#009788] text-[#6b7280]"
								>
									<span class="material-symbols-rounded text-base">bookmark</span>
									Tandai
								</button>
							</div>
						</div>
						<span class="text-[10px] font-bold font-mono px-2 py-0.5 rounded bg-gray-100 dark:bg-gray-800 text-gray-500">
							${ayah.ayah_number}
						</span>
					</div>
					<div class="flex-1 space-y-4">
						<div class="text-right leading-[2.4] text-[#111827] dark:text-white font-['Scheherazade_New'] font-bold flex items-center justify-end flex-wrap gap-2">
							<span class="arabic-text" style="font-size: ${savedFontSize}px;">
								${ayah.arab}
							</span>
							<span class="inline-flex items-center justify-center w-8 h-8 rounded-full border border-[#009788] text-[#009788] text-sm font-['Amiri'] font-bold ml-2">
								${toArabicNum(ayah.ayah_number)}
							</span>
						</div>
						<div class="latin-container text-xs sm:text-sm font-medium text-[#009788] leading-relaxed ${latinHidden}">
							<span class="italic">Ayat ${ayah.ayah_number}</span>
						</div>
						<div class="isyarat-badge hidden items-center gap-1 px-2.5 py-1 rounded-lg bg-[#009788] text-white text-[11px] font-bold shadow-xs">
							<span class="material-symbols-rounded text-sm">front_hand</span>
							ISYARAT: Aksesibilitas Pembacaan Ayat ${ayah.ayah_number}
						</div>
						<div data-ayah-num="${ayah.ayah_number}" class="translation-container text-xs sm:text-sm text-[#4b5563] dark:text-gray-300 leading-relaxed font-normal ${translationHidden}">
							${ayah.translation || ''}
						</div>
					</div>
				</div>`;
			}

			function attachCardListeners(container: Element) {
				container.querySelectorAll('.single-play-btn').forEach((btn) => {
					btn.addEventListener('click', (e) => {
						const num = parseInt((e.currentTarget as HTMLElement).getAttribute('data-ayah-num') || '1', 10);
						playAyahInSequence(num);
					});
				});
				container.querySelectorAll('.show-tafsir-btn').forEach(btn => {
					btn.addEventListener('click', (e) => {
						const target = e.currentTarget as HTMLElement;
						const sName = target.getAttribute('data-surah-name');
						const aNum = target.getAttribute('data-ayah-num');
						const shortTafsir = target.getAttribute('data-tafsir-short');
						const longTafsir = target.getAttribute('data-tafsir-long');
						const tafsirTitle = document.getElementById('tafsir-modal-title');
						const tafsirBody = document.getElementById('tafsir-modal-body');
						const tafsirOverlay = document.getElementById('tafsir-modal-overlay');
						const tafsirModal = document.getElementById('tafsir-modal');
						if (tafsirTitle) tafsirTitle.textContent = `Tafsir Surah ${sName} Ayat ${aNum}`;
						if (tafsirBody) tafsirBody.textContent = longTafsir || shortTafsir || 'Tafsir tidak tersedia.';
						tafsirOverlay?.classList.remove('hidden');
						tafsirModal?.classList.remove('hidden');
					});
				});
				container.querySelectorAll('.bookmark-btn').forEach(btn => {
					btn.addEventListener('click', (e) => {
						const target = e.currentTarget as HTMLElement;
						const slug = target.getAttribute('data-surah-slug');
						const name = target.getAttribute('data-surah-name');
						const ayah = target.getAttribute('data-ayah-num');
						localStorage.setItem('lastReadSurah', JSON.stringify({ slug, name, ayah }));
						showToast(`Ditandai: Surah ${name} Ayat ${ayah} sebagai terakhir dibaca`);
					});
				});
			}

			function loadMoreAyahs() {
				if (isAllLoaded) return;

				const container = document.getElementById('quran-ayahs-container');
				if (!container) return;

				const nextBatch = allAyahs.slice(loadedAyahCount, loadedAyahCount + BATCH_SIZE);
				if (nextBatch.length === 0) {
					isAllLoaded = true;
					hideSentinel();
					return;
				}

				const tempDiv = document.createElement('div');
				nextBatch.forEach((ayah: any) => {
					tempDiv.innerHTML = buildAyahCardHTML(ayah);
					const card = tempDiv.firstElementChild;
					if (card) {
						container.appendChild(card);
						attachCardListeners(card);
					}
				});

				loadedAyahCount += nextBatch.length;

				if (loadedAyahCount >= allAyahs.length) {
					isAllLoaded = true;
					hideSentinel();
				}

				const settings = JSON.parse(localStorage.getItem('quran_settings') || '{}');
				if (settings.tajweed) document.body.classList.add('tajweed-active');
				if (settings.isyarat) document.body.classList.add('isyarat-active');
			}

			function hideSentinel() {
				const sentinel = document.getElementById('infinite-scroll-sentinel');
				if (sentinel) sentinel.style.display = 'none';
			}

			const sentinel = document.getElementById('infinite-scroll-sentinel');
			if (sentinel) {
				if (isAllLoaded) {
					hideSentinel();
				} else {
					const observer = new IntersectionObserver((entries) => {
						entries.forEach(entry => {
							if (entry.isIntersecting && !isAllLoaded) {
								loadMoreAyahs();
							}
						});
					}, { rootMargin: '400px' });
					observer.observe(sentinel);
				}
			}

			function ensureAyahLoaded(ayahIndex: number) {
				while (loadedAyahCount < ayahIndex && !isAllLoaded) {
					loadMoreAyahs();
				}
			}

			function getReciterAudioUrl(reciterKey: string, sNum: number, aNum: number): string {
				const sPad = String(sNum).padStart(3, '0');
				const aPad = String(aNum).padStart(3, '0');
				const file = `${sPad}${aPad}.mp3`;

				switch(reciterKey) {
					case 'sudais':
						return `https://everyayah.com/data/Abdurrahmaan_As-Sudais_192kbps/${file}`;
					case 'ghamdi':
						return `https://everyayah.com/data/Ghamadi_40kbps/${file}`;
					case 'husary':
						return `https://everyayah.com/data/Husary_128kbps/${file}`;
					case 'shatri':
						return `https://everyayah.com/data/Abu_Bakr_Ash-Shaatree_128kbps/${file}`;
					case 'mishari':
					default:
						return `https://cdn.myquran.com/audio/ayah/${file}`;
				}
			}

			let selectedQori = 'mishari';
			let isContinuousPlaying = false;
			let currentAyahPlayingIndex = 1;
			let activeAudioObj: HTMLAudioElement | null = null;

			const playFullSurahBtn = document.getElementById('play-full-surah-btn');
			const fullPlayerBar = document.getElementById('full-audio-player-bar');
			const playerAyahTitle = document.getElementById('player-ayah-title');
			const playerPlayPauseBtn = document.getElementById('player-play-pause-btn');
			const playerPlayIcon = document.getElementById('player-play-icon');
			const playerPlayText = document.getElementById('player-play-text');
			const playerPrevBtn = document.getElementById('player-prev-btn');
			const playerNextBtn = document.getElementById('player-next-btn');
			const playerStopBtn = document.getElementById('player-stop-btn');
			const qoriSelect = document.getElementById('qori-select') as HTMLInputElement;
			const qoriDropdownTrigger = document.getElementById('qori-dropdown-trigger');
			const qoriDropdownMenu = document.getElementById('qori-dropdown-menu');
			const qoriDropdownRoot = document.getElementById('qori-dropdown-root');
			const qoriSelectedLabel = document.getElementById('qori-selected-label');

			const qoriNameMap: Record<string, string> = {
				'mishari': 'Mishari Rashid Alafasy',
				'sudais': 'Abdul Rahman Al-Sudais',
				'ghamdi': 'Saad Al-Ghamdi',
				'husary': 'Mahmoud Khalil Al-Husary',
				'shatri': 'Abu Bakr Al-Shatri'
			};

			qoriDropdownTrigger?.addEventListener('click', (e) => {
				e.stopPropagation();
				qoriDropdownMenu?.classList.toggle('hidden');
			});

			document.querySelectorAll('.qori-option-btn').forEach((btn) => {
				btn.addEventListener('click', (e) => {
					const val = (e.currentTarget as HTMLElement).getAttribute('data-qori') || 'mishari';
					selectedQori = val;
					if (qoriSelect) qoriSelect.value = val;
					if (qoriSelectedLabel) qoriSelectedLabel.textContent = qoriNameMap[val] || val;

					document.querySelectorAll('.qori-option-btn .qori-check').forEach(c => c.classList.add('hidden'));
					const check = (e.currentTarget as HTMLElement).querySelector('.qori-check');
					if (check) check.classList.remove('hidden');

					qoriDropdownMenu?.classList.add('hidden');
					saveSettings({ qori: selectedQori });
					if (isContinuousPlaying) {
						playAyahInSequence(currentAyahPlayingIndex);
					}
				});
			});

			document.addEventListener('click', (e) => {
				if (qoriDropdownMenu && !qoriDropdownRoot?.contains(e.target as Node)) {
					qoriDropdownMenu.classList.add('hidden');
				}
			});

			function playAyahInSequence(ayahIndex: number) {
				if (ayahIndex < 1 || ayahIndex > totalAyahs) {
					stopContinuousPlay();
					return;
				}

				ensureAyahLoaded(ayahIndex);

				currentAyahPlayingIndex = ayahIndex;
				isContinuousPlaying = true;
				fullPlayerBar?.classList.remove('hidden');

				if (playerAyahTitle) playerAyahTitle.textContent = `Ayat ${ayahIndex} / ${totalAyahs}`;

				const progressBar = document.getElementById('player-progress-bar');
				if (progressBar) {
					const pct = totalAyahs > 1 ? ((ayahIndex - 1) / (totalAyahs - 1)) * 100 : 100;
					progressBar.style.width = `${pct}%`;
				}

				const counterEl = document.getElementById('player-counter');
				if (counterEl) counterEl.textContent = `${ayahIndex} / ${totalAyahs}`;

				document.querySelectorAll('.ayah-card').forEach((card) => {
					card.classList.remove('playing-ayah-active');
				});
				const activeCard = document.getElementById(`ayah-${ayahIndex}`);
				if (activeCard) {
					activeCard.classList.add('playing-ayah-active');
					activeCard.scrollIntoView({ behavior: 'smooth', block: 'center' });
				}

				if (activeAudioObj) {
					activeAudioObj.pause();
					activeAudioObj = null;
				}

				const audioUrl = getReciterAudioUrl(selectedQori, surahNum, ayahIndex);
				activeAudioObj = new Audio(audioUrl);
				activeAudioObj.play();

				if (playerPlayIcon) playerPlayIcon.textContent = 'pause';
				if (playerPlayText) playerPlayText.textContent = 'Jeda';

				activeAudioObj.onended = () => {
					if (currentAyahPlayingIndex < totalAyahs) {
						playAyahInSequence(currentAyahPlayingIndex + 1);
					} else {
						stopContinuousPlay();
					}
				};

				activeAudioObj.onerror = () => {
					if (selectedQori !== 'mishari') {
						const fallbackUrl = getReciterAudioUrl('mishari', surahNum, ayahIndex);
						activeAudioObj = new Audio(fallbackUrl);
						activeAudioObj.play();
						activeAudioObj.onended = () => {
							if (currentAyahPlayingIndex < totalAyahs) {
								playAyahInSequence(currentAyahPlayingIndex + 1);
							} else {
								stopContinuousPlay();
							}
						};
					}
				};
			}

			function stopContinuousPlay() {
				isContinuousPlaying = false;
				if (activeAudioObj) {
					activeAudioObj.pause();
					activeAudioObj = null;
				}
				fullPlayerBar?.classList.add('hidden');
				document.querySelectorAll('.ayah-card').forEach((card) => {
					card.classList.remove('playing-ayah-active');
				});
				const progressBar = document.getElementById('player-progress-bar');
				if (progressBar) progressBar.style.width = '0%';
			}

			playFullSurahBtn?.addEventListener('click', () => {
				playAyahInSequence(1);
			});

			playerPlayPauseBtn?.addEventListener('click', () => {
				if (!activeAudioObj) return;
				if (activeAudioObj.paused) {
					activeAudioObj.play();
					if (playerPlayIcon) playerPlayIcon.textContent = 'pause';
					if (playerPlayText) playerPlayText.textContent = 'Jeda';
				} else {
					activeAudioObj.pause();
					if (playerPlayIcon) playerPlayIcon.textContent = 'play_arrow';
					if (playerPlayText) playerPlayText.textContent = 'Putar';
				}
			});

			playerPrevBtn?.addEventListener('click', () => {
				if (currentAyahPlayingIndex > 1) {
					playAyahInSequence(currentAyahPlayingIndex - 1);
				}
			});

			playerNextBtn?.addEventListener('click', () => {
				if (currentAyahPlayingIndex < totalAyahs) {
					playAyahInSequence(currentAyahPlayingIndex + 1);
				}
			});

			playerStopBtn?.addEventListener('click', () => {
				stopContinuousPlay();
			});

			document.querySelectorAll('.single-play-btn').forEach((btn) => {
				btn.addEventListener('click', (e) => {
					const num = parseInt((e.currentTarget as HTMLElement).getAttribute('data-ayah-num') || '1', 10);
					playAyahInSequence(num);
				});
			});

			const editionMap: Record<string, string> = {
				'ID': 'id.indonesian',
				'EN': 'en.sahih',
				'MY': 'ms.basmeih',
				'FR': 'fr.hamidullah',
				'DE': 'de.aburida',
				'TR': 'tr.ates'
			};

			async function fetchTranslation(langCode: string) {
				const edition = editionMap[langCode] || 'id.indonesian';
				try {
					const res = await fetch(`https://api.alquran.cloud/v1/surah/${surahNum}/${edition}`);
					const json = await res.json();
					if (json && json.data && Array.isArray(json.data.ayahs)) {
						json.data.ayahs.forEach((a: any) => {
							const el = document.querySelector(`.translation-container[data-ayah-num="${a.numberInSurah}"]`);
							if (el) {
								el.textContent = a.text;
							}
						});
					}
				} catch (err) {
					console.error("Gagal memuat terjemahan bahasa:", err);
				}
			}

			document.querySelectorAll('.lang-btn').forEach((btn) => {
				btn.addEventListener('click', (e) => {
					document.querySelectorAll('.lang-btn').forEach((b) => {
						b.classList.remove('bg-[#009788]', 'text-white');
						b.classList.add('bg-gray-100', 'dark:bg-gray-800', 'text-gray-600', 'dark:text-gray-300');
					});
					const target = e.currentTarget as HTMLElement;
					target.classList.remove('bg-gray-100', 'dark:bg-gray-800', 'text-gray-600', 'dark:text-gray-300');
					target.classList.add('bg-[#009788]', 'text-white');

					const lang = target.getAttribute('data-lang') || 'ID';
					saveSettings({ lang: lang });
					fetchTranslation(lang);
				});
			});

			const toggleTajweed = document.getElementById('toggle-tajweed') as HTMLInputElement;
			const toggleIsyarat = document.getElementById('toggle-isyarat') as HTMLInputElement;

			toggleTajweed?.addEventListener('change', (e) => {
				const isChecked = (e.target as HTMLInputElement).checked;
				document.body.classList.toggle('tajweed-active', isChecked);
				saveSettings({ tajweed: isChecked });
			});

			toggleIsyarat?.addEventListener('change', (e) => {
				const isChecked = (e.target as HTMLInputElement).checked;
				document.body.classList.toggle('isyarat-active', isChecked);
				saveSettings({ isyarat: isChecked });
			});

			const surahDropRoot = document.getElementById('surah-dropdown-root');
			const surahDropTrigger = document.getElementById('surah-dropdown-trigger');
			const surahDropMenu = document.getElementById('surah-dropdown-menu');
			const surahSearchInput = document.getElementById('surah-search-input') as HTMLInputElement;

			const ayahDropRoot = document.getElementById('ayah-dropdown-root');
			const ayahDropTrigger = document.getElementById('ayah-dropdown-trigger');
			const ayahDropMenu = document.getElementById('ayah-dropdown-menu');

			const settingsToggleBtn = document.getElementById('settings-toggle-btn');
			const settingsPanel = document.getElementById('settings-panel');
			const closeSettingsBtn = document.getElementById('close-settings-btn');

			surahDropTrigger?.addEventListener('click', (e) => {
				e.stopPropagation();
				surahDropMenu?.classList.toggle('hidden');
				ayahDropMenu?.classList.add('hidden');
				settingsPanel?.classList.add('hidden');
				if (surahSearchInput) {
					surahSearchInput.value = '';
					surahSearchInput.focus();
					filterSurahs('');
				}
			});

			function filterSurahs(query: string) {
				const items = document.querySelectorAll('.surah-option-item');
				const q = query.trim().toLowerCase();
				items.forEach((item) => {
					const text = item.getAttribute('data-search') || item.textContent || '';
					if (!q || text.toLowerCase().includes(q)) {
						(item as HTMLElement).style.display = 'flex';
					} else {
						(item as HTMLElement).style.display = 'none';
					}
				});
			}

			surahSearchInput?.addEventListener('input', () => {
				filterSurahs(surahSearchInput.value);
			});

			ayahDropTrigger?.addEventListener('click', (e) => {
				e.stopPropagation();
				ayahDropMenu?.classList.toggle('hidden');
				surahDropMenu?.classList.add('hidden');
				settingsPanel?.classList.add('hidden');
			});

			document.querySelectorAll('.ayah-option-btn').forEach((btn) => {
				btn.addEventListener('click', (e) => {
					const ayahNum = (e.currentTarget as HTMLElement).getAttribute('data-ayah-num');
					ayahDropMenu?.classList.add('hidden');
					if (ayahNum) {
						const label = document.getElementById('selected-ayah-label');
						if (label) label.textContent = `Ayat ${ayahNum}`;
						const el = document.getElementById(`ayah-${ayahNum}`);
						if (el) {
							el.scrollIntoView({ behavior: 'smooth', block: 'center' });
						}
					}
				});
			});

			settingsToggleBtn?.addEventListener('click', (e) => {
				e.stopPropagation();
				settingsPanel?.classList.toggle('hidden');
				surahDropMenu?.classList.add('hidden');
				ayahDropMenu?.classList.add('hidden');
			});

			closeSettingsBtn?.addEventListener('click', () => {
				settingsPanel?.classList.add('hidden');
			});

			document.addEventListener('click', (e) => {
				const target = e.target as Node;
				if (surahDropMenu && !surahDropRoot?.contains(target)) {
					surahDropMenu.classList.add('hidden');
				}
				if (ayahDropMenu && !ayahDropRoot?.contains(target)) {
					ayahDropMenu.classList.add('hidden');
				}
				if (settingsPanel && !settingsPanel.contains(target) && !settingsToggleBtn?.contains(target)) {
					settingsPanel.classList.add('hidden');
				}
			});

			const fontSizeSlider = document.getElementById('font-size-slider') as HTMLInputElement;
			const fontSizeVal = document.getElementById('font-size-val');

			const toggleLatin = document.getElementById('toggle-latin') as HTMLInputElement;
			const toggleTranslation = document.getElementById('toggle-translation') as HTMLInputElement;

			const savedSettings = JSON.parse(localStorage.getItem('quran_settings') || '{}');
			
			if (savedSettings.fontSize) {
				if (fontSizeSlider) fontSizeSlider.value = savedSettings.fontSize;
				if (fontSizeVal) fontSizeVal.textContent = `${savedSettings.fontSize}px`;
				updateArabicFontSize(savedSettings.fontSize);
			}

			if (savedSettings.showLatin !== undefined && toggleLatin) {
				toggleLatin.checked = savedSettings.showLatin;
				updateLatinVisibility(savedSettings.showLatin);
			}

			if (savedSettings.showTranslation !== undefined && toggleTranslation) {
				toggleTranslation.checked = savedSettings.showTranslation;
				updateTranslationVisibility(savedSettings.showTranslation);
			}

			if (savedSettings.tajweed && toggleTajweed) {
				toggleTajweed.checked = true;
				document.body.classList.add('tajweed-active');
			}

			if (savedSettings.isyarat && toggleIsyarat) {
				toggleIsyarat.checked = true;
				document.body.classList.add('isyarat-active');
			}

			if (savedSettings.qori) {
				const qoriBtn = document.querySelector(`.qori-option-btn[data-qori="${savedSettings.qori}"]`);
				if (qoriBtn) (qoriBtn as HTMLElement).click();
			}

			if (savedSettings.lang && savedSettings.lang !== 'ID') {
				const btn = document.querySelector(`.lang-btn[data-lang="${savedSettings.lang}"]`);
				if (btn) (btn as HTMLElement).click();
			}

			fontSizeSlider?.addEventListener('input', (e) => {
				const val = (e.target as HTMLInputElement).value;
				if (fontSizeVal) fontSizeVal.textContent = `${val}px`;
				updateArabicFontSize(val);
				saveSettings({ fontSize: val });
			});

			function updateArabicFontSize(size: string | number) {
				document.querySelectorAll('.arabic-text').forEach((el) => {
					(el as HTMLElement).style.fontSize = `${size}px`;
				});
			}

			toggleLatin?.addEventListener('change', (e) => {
				const isChecked = (e.target as HTMLInputElement).checked;
				updateLatinVisibility(isChecked);
				saveSettings({ showLatin: isChecked });
			});

			function updateLatinVisibility(show: boolean) {
				document.querySelectorAll('.latin-container').forEach((el) => {
					if (show) {
						el.classList.remove('hidden');
					} else {
						el.classList.add('hidden');
					}
				});
			}

			toggleTranslation?.addEventListener('change', (e) => {
				const isChecked = (e.target as HTMLInputElement).checked;
				updateTranslationVisibility(isChecked);
				saveSettings({ showTranslation: isChecked });
			});

			function updateTranslationVisibility(show: boolean) {
				document.querySelectorAll('.translation-container').forEach((el) => {
					if (show) {
						el.classList.remove('hidden');
					} else {
						el.classList.add('hidden');
					}
				});
			}

			function saveSettings(newSettings: Record<string, any>) {
				const current = JSON.parse(localStorage.getItem('quran_settings') || '{}');
				localStorage.setItem('quran_settings', JSON.stringify({ ...current, ...newSettings }));
			}

			document.querySelectorAll('.bookmark-btn').forEach(btn => {
				btn.addEventListener('click', (e) => {
					const target = e.currentTarget as HTMLElement;
					const slug = target.getAttribute('data-surah-slug');
					const name = target.getAttribute('data-surah-name');
					const ayah = target.getAttribute('data-ayah-num');

					localStorage.setItem('lastReadSurah', JSON.stringify({
						slug: slug,
						name: name,
						ayah: ayah
					}));

					showToast(`Ditandai: Surah ${name} Ayat ${ayah} sebagai terakhir dibaca`);
				});
			});

			const tafsirOverlay = document.getElementById('tafsir-modal-overlay');
			const tafsirModal = document.getElementById('tafsir-modal');
			const tafsirTitle = document.getElementById('tafsir-modal-title');
			const tafsirBody = document.getElementById('tafsir-modal-body');
			const closeTafsirBtn = document.getElementById('close-tafsir-btn');

			document.querySelectorAll('.show-tafsir-btn').forEach(btn => {
				btn.addEventListener('click', (e) => {
					const target = e.currentTarget as HTMLElement;
					const surahName = target.getAttribute('data-surah-name');
					const ayahNum = target.getAttribute('data-ayah-num');
					const shortTafsir = target.getAttribute('data-tafsir-short');
					const longTafsir = target.getAttribute('data-tafsir-long');

					if (tafsirTitle) tafsirTitle.textContent = `Tafsir Surah ${surahName} Ayat ${ayahNum}`;
					if (tafsirBody) tafsirBody.textContent = longTafsir || shortTafsir || 'Tafsir tidak tersedia.';

					tafsirOverlay?.classList.remove('hidden');
					tafsirModal?.classList.remove('hidden');
				});
			});

			closeTafsirBtn?.addEventListener('click', () => {
				tafsirOverlay?.classList.add('hidden');
				tafsirModal?.classList.add('hidden');
			});

			tafsirOverlay?.addEventListener('click', () => {
				tafsirOverlay?.classList.add('hidden');
				tafsirModal?.classList.add('hidden');
			});
			function showToast(message: string) {
				const toast = document.getElementById('toast-notif');
				const toastMsg = document.getElementById('toast-message');
				if (!toast || !toastMsg) return;
				toastMsg.textContent = message;
				toast.classList.remove('translate-y-full', 'opacity-0');
				toast.classList.add('translate-y-0', 'opacity-100');
				setTimeout(() => {
					toast.classList.remove('translate-y-0', 'opacity-100');
					toast.classList.add('translate-y-full', 'opacity-0');
				}, 2500);
			}
		</script>

		<div id="toast-notif" class="fixed bottom-24 md:bottom-6 left-1/2 -translate-x-1/2 translate-y-full opacity-0 z-[9999] transition-all duration-300 ease-out pointer-events-none">
			<div class="flex items-center gap-2.5 px-5 py-3 rounded-xl bg-[#009788] text-white text-sm font-semibold shadow-lg shadow-[#009788]/25">
				<span class="material-symbols-rounded text-lg">bookmark_added</span>
				<span id="toast-message"></span>
			</div>
		</div>
	</body>
</html>
