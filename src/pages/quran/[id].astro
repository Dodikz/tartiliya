---
import "../../styles/global.css";
import Navbar from "../../layouts/navbar.astro";
import { SURAH_LIST } from "../../data/surahs";
import { QuranService } from "../../lib/api/quran";

export function getStaticPaths() {
  return SURAH_LIST.map((s) => ({
    params: { id: String(s.number) },
  }));
}

const { id } = Astro.params;
const surahNumber = parseInt(id || "1", 10);
const surahMeta = SURAH_LIST.find((s) => s.number === surahNumber) || SURAH_LIST[0];

let ayahs: any[] = [];
let fetchError = "";

try {
  const res = await QuranService.getSurah(surahNumber);
  if (res && res.data) {
    if (Array.isArray(res.data)) {
      ayahs = res.data;
    } else if (Array.isArray((res.data as any).data)) {
      ayahs = (res.data as any).data;
    }
  }
} catch (err: any) {
  fetchError = err?.message || "Gagal memuat data ayat.";
}

const prevSurah = surahNumber > 1 ? SURAH_LIST[surahNumber - 2] : null;
const nextSurah = surahNumber < 114 ? SURAH_LIST[surahNumber] : null;
---

<html lang="id">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>Surah {surahMeta.name} - Tartiliya Al-Qur'an</title>
		
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Amiri:wght@400;700&family=Scheherazade+New:wght@400;700&display=swap" rel="stylesheet" />
		<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap" rel="stylesheet" />
		
		<script is:inline>
			const theme = localStorage.getItem('theme');
			if (theme === 'dark') {
				document.documentElement.classList.add('dark');
			}
		</script>
	</head>
	<body class="min-h-screen bg-[#f8fafc] dark:bg-[#111827] text-[#111827] dark:text-[#f8fafc] transition-colors duration-300">
		<Navbar />
		
		<main class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
			<div class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-[#009788] to-[#0d8174] text-white p-6 sm:p-10 text-center shadow-xl shadow-[#009788]/15 mb-8">
				<a href="/" class="inline-flex items-center gap-1 px-3 py-1 rounded-full bg-white/10 hover:bg-white/20 text-xs font-semibold text-emerald-100 mb-4 transition-colors">
					<span class="material-symbols-rounded text-sm">arrow_back</span>
					Daftar Surah
				</a>
				
				<h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight mb-2">
					Surah {surahMeta.name}
				</h1>
				<p class="text-base sm:text-lg font-medium text-emerald-100 mb-2">
					{surahMeta.translation} • {surahMeta.numberOfAyahs} Ayat • {surahMeta.revelationType}
				</p>
				<span class="font-['Amiri'] text-4xl sm:text-5xl font-bold text-white block mt-2">
					{surahMeta.arabicName}
				</span>

				{surahNumber !== 1 && surahNumber !== 9 && (
					<div class="mt-8 font-['Scheherazade_New'] text-2xl sm:text-3xl text-emerald-100 tracking-wider">
						بِسْمِ اللّٰهِ الرَّحْمٰنِ الرَّحِيْمِ
					</div>
				)}
			</div>

			{fetchError && (
				<div class="p-6 rounded-2xl bg-red-50 dark:bg-red-900/20 border border-red-200 text-center text-red-600 dark:text-red-400 text-sm my-6">
					<span class="material-symbols-rounded text-3xl mb-1 block mx-auto">error</span>
					{fetchError}
				</div>
			)}

			<div class="space-y-6">
				{ayahs.map((ayah) => (
					<div 
						id={`ayah-${ayah.ayah_number}`}
						class="ayah-card p-5 sm:p-7 rounded-3xl bg-white dark:bg-[#111827] border border-[#f3f4f6] dark:border-[#6b7280]/20 shadow-sm transition-all hover:border-[#009788]/30"
					>
						<div class="flex items-center justify-between border-b border-[#f3f4f6] dark:border-[#6b7280]/15 pb-4 mb-6">
							<div class="flex items-center gap-2">
								<span class="w-8 h-8 rounded-xl bg-[#e3fcf0] dark:bg-[#0d8174]/20 text-[#009788] text-xs font-bold flex items-center justify-center border border-[#009788]/20">
									{surahNumber}:{ayah.ayah_number}
								</span>
							</div>

							<div class="flex items-center gap-2">
								{ayah.audio_url && (
									<button 
										data-audio={ayah.audio_url} 
										class="play-audio-btn px-3 py-1.5 rounded-xl bg-[#f3f4f6] dark:bg-[#111827] hover:bg-[#e3fcf0] dark:hover:bg-[#0d8174]/20 border border-[#6b7280]/20 text-xs font-semibold text-[#009788] flex items-center gap-1.5 transition-colors cursor-pointer"
									>
										<span class="material-symbols-rounded text-base">play_circle</span>
										Audio
									</button>
								)}

								{ayah.tafsir && (
									<button 
										data-tafsir-short={ayah.tafsir.kemenag?.short || ''} 
										data-tafsir-long={ayah.tafsir.kemenag?.long || ''}
										data-surah-name={surahMeta.name}
										data-ayah-num={ayah.ayah_number}
										class="show-tafsir-btn px-3 py-1.5 rounded-xl bg-[#f3f4f6] dark:bg-[#111827] hover:bg-[#e3fcf0] dark:hover:bg-[#0d8174]/20 border border-[#6b7280]/20 text-xs font-semibold text-[#6b7280] dark:text-[#696969] hover:text-[#009788] flex items-center gap-1.5 transition-colors cursor-pointer"
									>
										<span class="material-symbols-rounded text-base">auto_stories</span>
										Tafsir
									</button>
								)}

								<button 
									data-surah-num={surahNumber}
									data-surah-name={surahMeta.name}
									data-ayah-num={ayah.ayah_number}
									class="bookmark-btn p-1.5 rounded-xl bg-[#f3f4f6] dark:bg-[#111827] hover:bg-[#e3fcf0] border border-[#6b7280]/20 text-[#6b7280] hover:text-[#009788] transition-colors cursor-pointer"
									title="Tandai Terakhir Dibaca"
								>
									<span class="material-symbols-rounded text-lg">bookmark</span>
								</button>
							</div>
						</div>

						<div class="text-right font-['Scheherazade_New'] text-3xl sm:text-4xl leading-[2.2] text-[#111827] dark:text-[#ffffff] mb-6 font-bold tracking-wide">
							{ayah.arab}
						</div>

						<div class="text-sm sm:text-base text-[#6b7280] dark:text-[#696969] leading-relaxed font-medium">
							{ayah.translation}
						</div>
					</div>
				))}
			</div>

			<div class="flex items-center justify-between gap-4 mt-10 pt-6 border-t border-[#f3f4f6] dark:border-[#6b7280]/20">
				{prevSurah ? (
					<a href={`/quran/${prevSurah.number}`} class="flex items-center gap-2 p-3 px-5 rounded-2xl bg-white dark:bg-[#111827] border border-[#f3f4f6] dark:border-[#6b7280]/20 hover:border-[#009788] text-xs sm:text-sm font-bold text-[#009788] transition-all">
						<span class="material-symbols-rounded text-lg">arrow_back</span>
						Surah {prevSurah.name}
					</a>
				) : <div />}

				{nextSurah ? (
					<a href={`/quran/${nextSurah.number}`} class="flex items-center gap-2 p-3 px-5 rounded-2xl bg-white dark:bg-[#111827] border border-[#f3f4f6] dark:border-[#6b7280]/20 hover:border-[#009788] text-xs sm:text-sm font-bold text-[#009788] transition-all">
						Surah {nextSurah.name}
						<span class="material-symbols-rounded text-lg">arrow_forward</span>
					</a>
				) : <div />}
			</div>

			<div id="tafsir-modal-overlay" class="hidden fixed inset-0 z-[100] bg-black/60 transition-opacity"></div>
			<div id="tafsir-modal" class="hidden fixed top-[20%] left-1/2 -translate-x-1/2 z-[110] w-[90%] max-w-2xl bg-white dark:bg-[#111827] rounded-3xl shadow-2xl border border-[#f3f4f6] dark:border-[#6b7280]/30 overflow-hidden">
				<div class="flex items-center justify-between px-6 py-4 border-b border-[#f3f4f6] dark:border-[#6b7280]/20">
					<h3 id="tafsir-modal-title" class="font-bold text-base text-[#111827] dark:text-white flex items-center gap-2">
						<span class="material-symbols-rounded text-[#009788]">auto_stories</span>
						Tafsir Kemenag RI
					</h3>
					<button id="close-tafsir-btn" class="p-1 text-[#6b7280] hover:text-[#009788] cursor-pointer">
						<span class="material-symbols-rounded text-xl">close</span>
					</button>
				</div>
				<div class="p-6 max-h-[60vh] overflow-y-auto space-y-4">
					<div id="tafsir-modal-body" class="text-sm leading-relaxed text-[#6b7280] dark:text-[#696969] whitespace-pre-wrap font-medium"></div>
				</div>
			</div>
		</main>

		<script>
			let currentAudio: HTMLAudioElement | null = null;

			document.querySelectorAll('.play-audio-btn').forEach(btn => {
				btn.addEventListener('click', (e) => {
					const target = e.currentTarget as HTMLElement;
					const url = target.getAttribute('data-audio');
					if (!url) return;

					if (currentAudio) {
						currentAudio.pause();
						currentAudio = null;
					}

					currentAudio = new Audio(url);
					currentAudio.play();

					target.classList.add('bg-[#009788]', 'text-white');
					currentAudio.onended = () => {
						target.classList.remove('bg-[#009788]', 'text-white');
					};
				});
			});

			document.querySelectorAll('.bookmark-btn').forEach(btn => {
				btn.addEventListener('click', (e) => {
					const target = e.currentTarget as HTMLElement;
					const num = target.getAttribute('data-surah-num');
					const name = target.getAttribute('data-surah-name');
					const ayah = target.getAttribute('data-ayah-num');

					localStorage.setItem('lastReadSurah', JSON.stringify({
						number: num,
						name: name,
						ayah: ayah
					}));


					showToast(`Ditandai: Surah ${name} Ayat ${ayah} sebagai terakhir dibaca`);
				});
			});

			const tafsirOverlay = document.getElementById('tafsir-modal-overlay');
			const tafsirModal = document.getElementById('tafsir-modal');
			const tafsirTitle = document.getElementById('tafsir-modal-title');
			const tafsirBody = document.getElementById('tafsir-modal-body');
			const closeTafsirBtn = document.getElementById('close-tafsir-btn');

			document.querySelectorAll('.show-tafsir-btn').forEach(btn => {
				btn.addEventListener('click', (e) => {
					const target = e.currentTarget as HTMLElement;
					const surahName = target.getAttribute('data-surah-name');
					const ayahNum = target.getAttribute('data-ayah-num');
					const shortTafsir = target.getAttribute('data-tafsir-short');
					const longTafsir = target.getAttribute('data-tafsir-long');

					if (tafsirTitle) tafsirTitle.textContent = `Tafsir Surah ${surahName} Ayat ${ayahNum}`;
					if (tafsirBody) tafsirBody.textContent = longTafsir || shortTafsir || 'Tafsir tidak tersedia.';

					tafsirOverlay?.classList.remove('hidden');
					tafsirModal?.classList.remove('hidden');
				});
			});

			closeTafsirBtn?.addEventListener('click', () => {
				tafsirOverlay?.classList.add('hidden');
				tafsirModal?.classList.add('hidden');
			});

			tafsirOverlay?.addEventListener('click', () => {
				tafsirOverlay?.classList.add('hidden');
				tafsirModal?.classList.add('hidden');
			});
			function showToast(message: string) {
				const toast = document.getElementById('toast-notif');
				const toastMsg = document.getElementById('toast-message');
				if (!toast || !toastMsg) return;
				toastMsg.textContent = message;
				toast.classList.remove('translate-y-full', 'opacity-0');
				toast.classList.add('translate-y-0', 'opacity-100');
				setTimeout(() => {
					toast.classList.remove('translate-y-0', 'opacity-100');
					toast.classList.add('translate-y-full', 'opacity-0');
				}, 2500);
			}
		</script>

		<div id="toast-notif" class="fixed bottom-24 md:bottom-6 left-1/2 -translate-x-1/2 translate-y-full opacity-0 z-[9999] transition-all duration-300 ease-out pointer-events-none">
			<div class="flex items-center gap-2.5 px-5 py-3 rounded-xl bg-[#009788] text-white text-sm font-semibold shadow-lg shadow-[#009788]/25">
				<span class="material-symbols-rounded text-lg">bookmark_added</span>
				<span id="toast-message"></span>
			</div>
		</div>
	</body>
</html>
